scale   1;
// Ekaterinaris (2005) p.243: -2 <= x <= 2, 0 <= y <= 1. SQUARE cells at every
// level (dx = dy), refined by exactly 2 in BOTH directions, so the three meshes
// are geometrically similar and the Roache triple is a triple.
vertices
(
    (-2 0 0)  (2 0 0)  (2 1 0)  (-2 1 0)
    (-2 0 0.1)(2 0 0.1)(2 1 0.1)(-2 1 0.1)
);
blocks ( hex (0 1 2 3 4 5 6 7) (__NX__ __NY__ 1) simpleGrading (1 1 1) );
edges ();
boundary
(
    inlet  { type patch;          faces ((0 4 7 3)); }
    outlet { type patch;          faces ((1 2 6 5)); }
    bottom { type symmetryPlane;  faces ((0 1 5 4)); }
    top    { type patch;          faces ((3 7 6 2)); }
    frontAndBack { type empty;    faces ((0 3 2 1) (4 5 6 7)); }
);
