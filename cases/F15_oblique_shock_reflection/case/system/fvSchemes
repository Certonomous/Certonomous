FoamFile { version 2.0; format ascii; class dictionary; object fvSchemes; }
// Inherited verbatim from the shipped obliqueShock tutorial's fvSchemes.
fluxScheme          Kurganov;
ddtSchemes      { default Euler; }
// The graded quantities are STEADY-STATE values reached by pseudo-time marching,
// so the temporal order does NOT enter the spatial ladder. (Contrast F16, where
// dt must refine with dy because the solution is genuinely unsteady.)
gradSchemes     { default Gauss linear; }
divSchemes      { default none; div(tauMC) Gauss linear; }
laplacianSchemes{ default Gauss linear corrected; }
interpolationSchemes
{
    default          linear;
    reconstruct(rho) vanLeer;
    reconstruct(U)   vanLeerV;
    reconstruct(T)   vanLeer;
}
snGradSchemes   { default corrected; }
