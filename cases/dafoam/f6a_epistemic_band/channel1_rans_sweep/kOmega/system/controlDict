FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// DEVIATION (F6a, documented, same pattern as ladder B2 for the duct cases):
// original controlDict loaded "libfrozenIncompressibleTurbulenceModels.so",
// a custom library from the paper authors' thesis codebase, not distributed
// in the public closure-challenge-benchmark clone and not part of stock
// OpenFOAM. Removed here; RASModel kOmegaSST (see constant/turbulenceProperties)
// resolves to OpenFOAM v2606's stock implementation instead.
// libs ( "libfrozenIncompressibleTurbulenceModels.so" );

#include "../fieldDef"

startFrom       latestTime;

stopAt          endTime;

// D9: extended from 2000 to 8000. At t=2000 the run had NOT met its
// residualControl gate -- k final residual ~2.8e-6 vs the 5e-7 bar (omega
// and U/p were well inside).
//
// 2026-07-30 CORRECTION: t=8000 was reported as gate-met on its FINAL
// residual (k 1.373e-7). The gate is checked on the INITIAL residual,
// which at t=8000 is k 3.21e-5 (64x over), omega 3.72e-9 (37x over its
// 1e-10 bar), Uz 6.14e-6 (12x over), p 1.41e-6 (2.8x over) -- none met,
// and "SIMPLE solution converged" never printed. Checked with
// scripts/check_convergence.py after a deliberate estate-wide sweep found
// it. The Initial residuals ARE decaying smoothly and monotonically
// across 3000-8000 (k roughly x0.7 per 1000 iterations, no plateau) --
// this is not the corner/r4-sweep floor pattern -- so extended again,
// 8000 -> 25000, extrapolated need ~18000-20000 with margin. Nothing else
// changed. Solver stops itself early via residualControl once genuinely
// met, so this is a ceiling, not a forced iteration count.
endTime         25000;

deltaT          1;

writeControl    timeStep;

writeInterval   $endTime;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// DEVIATION: #includeFunc residuals/convergenceProbes/singleGraph_* dropped
// (same v2606 caseDicts-path finding as B2). wallShearStress + wallValues
// reinstated below as inline definitions (not #includeFunc, which failed
// when invoked standalone via postProcess -- the sampledSurfaces "wallValues"
// object needs wallShearStress already registered in the same run) so both
// execute in sequence at each writeTime, matching the case's own
// postProcess.sh intent (wallShearStress then wallValues sampling it).
functions
{
    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeFields     yes;
        executeControl  writeTime;
        writeControl    writeTime;
    }

    wallValues
    {
        type            surfaces;
        libs            ("libsampling.so");
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          $wallValuesFields;
        surfaces
        (
            wallValues
            {
                type        patch;
                patches     (bottom);
            }
        );
    }
}


