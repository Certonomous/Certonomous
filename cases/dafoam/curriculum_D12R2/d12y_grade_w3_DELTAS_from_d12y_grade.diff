+def _w_from_record(rows, ledger_path):
+    """W3-A2.  The window graded is the window that ran: every manifest row carries "W",
+    the rows agree, the ledger carries one W_STEPS=<n> line that agrees, and the value
+    is the registered W_PRIMARY.  Anything else REFUSES -- a comparator that can grade
+    the wrong window silently is the W2R-GRADER-DEF-1 defect."""
+    ws = set()
+    missing = [r.get("name") for r in rows if "W" not in r]
+    if missing:
+        raise Refusal("W3-A2: %d manifest row(s) carry no W key: %s" % (len(missing), missing[:6]))
+    for r in rows:
+        try:
+            ws.add(int(r["W"]))
+        except (TypeError, ValueError):
+            raise Refusal("W3-A2: row %r carries an unparseable W=%r" % (r.get("name"), r.get("W")))
+    if len(ws) != 1:
+        raise Refusal("W3-A2: manifest rows disagree on W: %s" % sorted(ws))
+    W_rows = ws.pop()
+    if not os.path.isfile(ledger_path):
+        raise Refusal("W3-A2: ledger absent at %s; W_STEPS cannot be cross-read" % ledger_path)
+    led = []
+    with open(ledger_path, errors="replace") as f:
+        for line in f:
+            m = re.match(r"^W_STEPS=(\d+)\b", line.strip())
+            if m:
+                led.append(int(m.group(1)))
+    if len(led) != 1:
+        raise Refusal("W3-A2: ledger carries %d W_STEPS= line(s), expected exactly 1: %s" % (len(led), led))
+    if led[0] != W_rows:
+        raise Refusal("W3-A2: ledger W_STEPS=%d disagrees with the manifest rows' W=%d" % (led[0], W_rows))
+    if W_rows != W_PRIMARY:
+        raise Refusal("W3-A2: the record's W=%d is not the registered W_PRIMARY=%d" % (W_rows, W_PRIMARY))
+    return W_rows
+
