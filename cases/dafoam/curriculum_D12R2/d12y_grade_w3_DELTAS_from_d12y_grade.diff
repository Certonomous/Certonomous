+def selftest_w3(tmpdir):
+    """Planted controls for the two W3 deltas, run under python3 and python3 -O.  Every
+    refusal is a raise; every success line is printed inside the branch that verified it."""
+    import tempfile
+    n = 0; bad = []
+    def unit(name, cond):
+        nonlocal n
+        n += 1
+        print("  [%s] %s" % ("OK " if cond else "BAD", name))
+        if not cond:
+            bad.append(name)
+    def refuses(rows, ledger_lines):
+        d = tempfile.mkdtemp(dir=tmpdir)
+        lp = os.path.join(d, "ledger.txt")
+        with open(lp, "w") as f:
+            f.write("\n".join(ledger_lines) + "\n")
+        try:
+            _w_from_record(rows, lp); return False
+        except Refusal:
+            return True
+    good = [{"name": "S%d" % i, "W": W_PRIMARY} for i in range(5)]
+    unit("W1 five rows W=%d + ledger W_STEPS=%d -> accepted, returns %d" % (W_PRIMARY, W_PRIMARY, W_PRIMARY),
+         not refuses(good, ["ITEM=X", "W_STEPS=%d deltaT=1e-2" % W_PRIMARY]) and
+         _w_from_record(good, _write_ledger(tmpdir, ["W_STEPS=%d deltaT=1e-2" % W_PRIMARY])) == W_PRIMARY)
+    unit("W2 one row without a W key -> REFUSED", refuses(good[:4] + [{"name": "S4"}], ["W_STEPS=%d" % W_PRIMARY]))
+    unit("W3 rows disagree (one at 300) -> REFUSED", refuses(good[:4] + [{"name": "S4", "W": 300}], ["W_STEPS=%d" % W_PRIMARY]))
+    unit("W4 ledger W_STEPS=900 against rows W=%d -> REFUSED (the W2R defect shape)" % W_PRIMARY, refuses(good, ["W_STEPS=900 deltaT=1e-2"]))
+    unit("W5 ledger without a W_STEPS line -> REFUSED", refuses(good, ["ITEM=X"]))
+    unit("W6 two W_STEPS lines -> REFUSED", refuses(good, ["W_STEPS=%d" % W_PRIMARY, "W_STEPS=%d" % W_PRIMARY]))
+    unit("W7 rows and ledger agree on 300 but 300 is not the registered W_PRIMARY -> REFUSED",
+         refuses([{"name": "S%d" % i, "W": 300} for i in range(5)], ["W_STEPS=300"]))
+    # ---- the envelope arithmetic on a synthetic periodic series (no run artefact needed)
+    import math
+    P = 18.9644; A = 0.06581
+    cd = [0.6563 + A * math.sin(2 * math.pi * i / P) for i in range(2400)]
+    g3 = g3_delta_window(cd, W_PRIMARY, period_steps=P)
+    env = C_ENV / float(W_PRIMARY)
+    used = max(g3["delta_window"], env)
+    unit("W8 envelope C_ENV/W at W=%d = %.4e, used = max(exact %.4e, envelope) = %.4e >= exact" % (W_PRIMARY, env, g3["delta_window"], used),
+         used >= g3["delta_window"] and used >= env and abs(env - C_ENV / W_PRIMARY) < 1e-18)
+    Wdeg = int(round(47 * P))   # ~891: a whole number of periods, the exact spread nearly cancels
+    g3d = g3_delta_window(cd, Wdeg, period_steps=P)
+    exactd = float(g3d["block_max"]) - float(g3d["block_min"])
+    usedd = max(exactd, C_ENV / Wdeg)
+    unit("W9 at a near-degenerate W=%d the frozen g3 EXCLUDES the term (delta_window=%r); W3-A1 recovers the exact spread %.2e from block_max-block_min and the envelope %.2e carries the floor -- NOT excluded" % (Wdeg, g3d["delta_window"], exactd, C_ENV / Wdeg),
+         g3d.get("degenerate") is True and g3d["delta_window"] is None and usedd == C_ENV / Wdeg and usedd > exactd)
+    ge = g4_delta_eff(0.0, usedd, 1.2e-6, window_degenerate=False)
+    unit("W10 g4_delta_eff accepts the envelope-carried delta_window as dominant with the flag not applied", ge["dominant_term"] == "delta_window" and ge["delta_eff"] == usedd)
+    hm = g4_step_sizing(C_ENV / W_PRIMARY, 1.13984)
+    unit("W11 step sizing on the envelope at |g|=1.13984: h_min=%.5f admissible=%s (the registered P3 point)" % (hm["h_min"], hm["verdict"] == "PASS"),
+         hm["verdict"] == "PASS" and abs(hm["h_min"] - 0.03907) < 5e-4)
+    hm2 = g4_step_sizing(C_ENV / W_PRIMARY, 0.85)
+    unit("W12 the falsifier: |g|=0.85 -> h_min=%.5f NOT admissible" % hm2["h_min"], hm2["verdict"] != "PASS")
+    print("W3 SELFTEST units=%d failures=%d python_O=%s" % (n, len(bad), not __debug__))
+    if n != 12 or bad:
+        print("W3 SELFTEST FAIL: %s" % (bad or "unit count"))
+        return 2
+    print("W3 SELFTEST PASS 12/12")
+    return 0
