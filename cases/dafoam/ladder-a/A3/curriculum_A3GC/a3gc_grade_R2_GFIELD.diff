+# ---- R2 Sec.4.4  G-FIELD.  Field stationarity, per N-D45's converse: a flat CD
+# history proves the INTEGRAL is stationary, not that the FIELD is converged.
+# Thresholds are derived from each statistic's own structure (see R2 Sec.4.4),
+# never from a value any completed run achieved.
+REG_FIELD_WINDOW = 500          # dense OUTER iterations, not printed samples
+REG_FIELD_EQNS = ("p", "Ux", "Uy", "Uz", "e", "nuTilda")
+# Limb 1, trend: |fitted log10 slope| * W / scatter-about-the-fit.  SNR = 1 is
+# the definitional boundary at which a remaining trend stops being
+# distinguishable from the window's own scatter.  No tuned constant.
+REG_FIELD_TREND_SNR_MAX = 1.0
+# Limb 2, alternation.  Applied ONLY to a level that passed limb 1, because a
+# surviving trend masks alternation (measured: the same L2 p series reads
+# lag-1 -0.744 at W=80 and +0.991 at W=500).
+# 2a: first-difference sign-alternation fraction.  1.000 for a pure period-2
+#     series, 0.5 for white noise, ~0 for a monotone one.  0.95 admits one
+#     non-alternating step in twenty (ties, a single glitch) and nothing that
+#     is not essentially a pure alternation.
+REG_FIELD_ALT_FRAC_MAX = 0.95
+# 2b: lag-1 autocorrelation.  -0.5 is where the alternating mode carries
+#     exactly half the series variance (x_t = a(-1)^t + e_t => lag1 =
+#     -a^2/(a^2+sig^2) = -0.5 <=> a^2 = sig^2).
+REG_FIELD_LAG1_MIN = -0.5
 
