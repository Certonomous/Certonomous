+def _logfit(xs, eq="?", where="?"):
+    """Least-squares fit of log10(x) vs index.  Returns (slope, scatter, resid).
+
+    D1: REFUSES on a non-positive or non-finite sample.  math.log10 raises
+    ValueError on 0.0 and on a negative, and a traceback is not a refusal --
+    this file's contract is refuse (exit 2) rather than degrade.  A converged
+    solve can legitimately print an initial residual of exactly 0, and a
+    truncated line can yield one, so this is a live path, not a theoretical one.
+    """
+    for i, v in enumerate(xs):
+        if not isinstance(v, float) or v != v or v in (float("inf"), float("-inf")):
+            refuse("G-FIELD", "%s %s: non-finite residual sample at window "
+                   "index %d: %r" % (where, eq, i, v))
+        if v <= 0.0:
+            refuse("G-FIELD", "%s %s: non-positive residual sample at window "
+                   "index %d: %r.  log10 is undefined there; refusing rather "
+                   "than crashing or silently dropping it." % (where, eq, i, v))
+    s = [math.log10(v) for v in xs]
+    n = len(s)
+    mx = (n - 1) / 2.0
+    my = sum(s) / n
+    den = sum((i - mx) ** 2 for i in range(n))
+    slope = sum((i - mx) * (s[i] - my) for i in range(n)) / den
+    resid = [s[i] - (my + slope * (i - mx)) for i in range(n)]
+    scatter = math.sqrt(sum(r * r for r in resid) / n)
+    return slope, scatter, resid
+
+
+def _field_stats(win, eq="?", where="?"):
+    """The three G-FIELD statistics for one equation's window."""
+    slope, scatter, resid = _logfit(win, eq, where)
+    snr = abs(slope) * len(win) / scatter if scatter > 0 else float("inf")
+    ss = sum(r * r for r in resid)
+    lag1 = (sum(resid[i] * resid[i + 1] for i in range(len(resid) - 1)) / ss
+            if ss > 0 else 0.0)
+    d = [resid[i + 1] - resid[i] for i in range(len(resid) - 1)]
+    nalt = sum(1 for i in range(len(d) - 1) if d[i] * d[i + 1] < 0)
+    altfrac = nalt / (len(d) - 1) if len(d) > 1 else 0.0
+    return snr, lag1, altfrac
+
+
+def plant_dense_field(src_log, scratch):
+    """Standing rule 3 for the NEW dense reader, driven BOTH WAYS.
+
+    Refusing on "I read zero lines" is not a planted control: it cannot show
+    the reader is able to see a non-zero.  This writes a copy of a real log
+    with the p `Solving for p` initial residuals REPLACED by a synthetic series
+    of known character, reads it back through `_DENSE_INITRES_RE`, and asserts
+    the gate reaches the known answer.  Refuses if it cannot.
+
+      case A  pure period-2 at PLANT_DENSE_BASE +/- PLANT_DENSE_AMP
+              -> reader must see PLANT_DENSE_BASE; limb 1 must PASS (no trend)
+                 and limb 2 must FAIL (alt-frac 1.000, lag1 near -1).
+      case B  pure monotone descent of PLANT_DENSE_DECADES over the window
+              -> limb 1 must FAIL, and limb 2 must NOT report alternation.
+
+    Case B is the half that matters most: a control that only ever shows red
+    proves nothing about a green.
+    """
+    W = REG_FIELD_WINDOW
+    cases = {}
+    cases["A"] = [PLANT_DENSE_BASE * (1.0 + (PLANT_DENSE_AMP if i % 2 else -PLANT_DENSE_AMP))
+                  for i in range(W)]
+    cases["B"] = [PLANT_DENSE_BASE * 10.0 ** (-PLANT_DENSE_DECADES * i / (W - 1.0))
+                  for i in range(W)]
+    for name, series in cases.items():
+        path = _write_planted_dense_log(src_log, scratch, series, name)
+        got = (read_log(path).get("dense_initres") or {}).get("p") or []
+        if len(got) < W:
+            refuse("G-PLANT-DENSE", "case %s: planted %d p samples, dense "
+                   "reader read back %d.  The reader is structurally blind to "
+                   "the very lines G-FIELD grades on." % (name, W, len(got)))
+        win = got[-W:]
+        if abs(win[0] - series[0]) > 1e-12 * max(1.0, abs(series[0])):
+            refuse("G-PLANT-DENSE", "case %s: planted %.6e at window index 0, "
+                   "read back %.6e." % (name, series[0], win[0]))
+        snr, lag1, altfrac = _field_stats(win, "p", "PLANT-" + name)
+        if name == "A":
+            if snr > REG_FIELD_TREND_SNR_MAX:
+                refuse("G-PLANT-DENSE", "case A: a planted trend-free "
+                       "alternation read trend SNR %.3f > %g -- limb 1 is "
+                       "firing on something that has no trend."
+                       % (snr, REG_FIELD_TREND_SNR_MAX))
+            if altfrac < REG_FIELD_ALT_FRAC_MAX or lag1 > REG_FIELD_LAG1_MIN:
+                refuse("G-PLANT-DENSE", "case A: a planted PURE period-2 "
+                       "series read alt-frac %.3f and lag-1 %+.3f -- limb 2 "
+                       "CANNOT SEE an alternation it is the whole point of."
+                       % (altfrac, lag1))
+        else:
+            if snr <= REG_FIELD_TREND_SNR_MAX:
+                refuse("G-PLANT-DENSE", "case B: a planted %g-decade monotone "
+                       "descent read trend SNR %.3f <= %g -- limb 1 cannot see "
+                       "a descent." % (PLANT_DENSE_DECADES, snr,
+                                       REG_FIELD_TREND_SNR_MAX))
+            if altfrac >= REG_FIELD_ALT_FRAC_MAX or lag1 <= REG_FIELD_LAG1_MIN:
+                refuse("G-PLANT-DENSE", "case B: a planted MONOTONE descent "
+                       "was reported as alternating (alt-frac %.3f, lag-1 "
+                       "%+.3f) -- limb 2 shows red on a clean input."
+                       % (altfrac, lag1))
+    print("  G-PLANT-DENSE: dense reader sees a planted period-2 (limb 2 red) "
+          "AND a planted monotone descent (limb 1 red, limb 2 green).  Both "
+          "directions demonstrated.")
+    return True
+
+
+def gate_g_field(log, report, level):
+    """R2 Sec.4.4 G-FIELD.  Field stationarity, SEQUENTIALLY:
+         limb 1 (trend)       -- every equation, at REG_FIELD_WINDOW.
+         limb 2 (alternation) -- ONLY where limb 1 passed, on the DETRENDED
+                                 series, because a surviving trend masks it.
+    A level failing either limb is NOT plateaued, whatever its peak-to-peak.
+    Every statistic is PRINTED for every equation whether or not it gates.
+    """
+    print("\n--- G-FIELD  (R2 Sec.4.4)  window = %d dense outer iterations ---"
+          % REG_FIELD_WINDOW)
+    dense = log.get("dense_initres") or {}
+    if not dense:
+        refuse("G-FIELD", "%s: read ZERO dense per-iteration residual lines."
+               % log["path"])
+    ok_all = True
+    rec = {}
+    for eq in REG_FIELD_EQNS:
+        v = dense.get(eq) or []
+        if len(v) < REG_FIELD_WINDOW:
+            print("  %-8s only %d dense samples (need %d) -> NOT A RESULT for "
+                  "want of evidence" % (eq, len(v), REG_FIELD_WINDOW))
+            rec[eq] = {"n": len(v), "verdict": "NOT A RESULT"}
+            ok_all = False
+            continue
+        win = v[-REG_FIELD_WINDOW:]
+        snr, lag1, altfrac = _field_stats(win, eq, level)
+        trend_ok = snr <= REG_FIELD_TREND_SNR_MAX
+        alt_ok = (altfrac < REG_FIELD_ALT_FRAC_MAX and lag1 > REG_FIELD_LAG1_MIN)
+        if trend_ok:
+            eq_ok = alt_ok
+            note = "" if alt_ok else "  <-- ALTERNATING (period-2 limit cycle)"
+        else:
+            eq_ok = False
+            note = "  <-- STILL DESCENDING (limb 2 computed, not gated)"
+        ok_all = ok_all and eq_ok
+        print("  %-8s trend SNR = %8.3f (<= %g) %-4s | alt-frac = %.3f (< %g) "
+              "| lag-1 = %+.3f (> %g) %s"
+              % (eq, snr, REG_FIELD_TREND_SNR_MAX, "OK" if trend_ok else "FAIL",
+                 altfrac, REG_FIELD_ALT_FRAC_MAX, lag1, REG_FIELD_LAG1_MIN, note))
+        rec[eq] = {"n": len(v), "window": REG_FIELD_WINDOW, "trend_snr": snr,
+                   "trend_ok": trend_ok, "alt_frac": altfrac, "lag1": lag1,
+                   "alt_ok": alt_ok, "verdict": "PASS" if eq_ok else "NOT A RESULT"}
+    report.setdefault("G-FIELD", {})[level] = rec
+    print("  G-FIELD %s: %s" % (level, "OK" if ok_all else "NOT A RESULT"))
+    return ok_all
+
