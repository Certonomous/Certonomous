+def _logfit(xs):
+    """Least-squares fit of log10(x) vs index.  Returns (slope, scatter, resid)."""
+    s = [math.log10(v) for v in xs]
+    n = len(s)
+    mx = (n - 1) / 2.0
+    my = sum(s) / n
+    den = sum((i - mx) ** 2 for i in range(n))
+    slope = sum((i - mx) * (s[i] - my) for i in range(n)) / den
+    resid = [s[i] - (my + slope * (i - mx)) for i in range(n)]
+    scatter = math.sqrt(sum(r * r for r in resid) / n)
+    return slope, scatter, resid
+
+
+def gate_g_field(log, report, level):
+    """R2 Sec.4.4 G-FIELD.  Field stationarity, SEQUENTIALLY:
+
+      limb 1 (trend)       -- on every equation, at REG_FIELD_WINDOW.
+      limb 2 (alternation) -- ONLY on equations that passed limb 1, because a
+                              surviving trend masks the alternation.
+
+    A level failing either limb is NOT plateaued and its row is NOT A RESULT,
+    whatever its peak-to-peak.  Every statistic is PRINTED for every equation
+    whether or not it gates, so a cold reader sees what the gate saw.
+    """
+    print("\n--- G-FIELD  (R2 Sec.4.4)  window = %d dense outer iterations ---"
+          % REG_FIELD_WINDOW)
+    dense = log.get("dense_initres") or {}
+    if not dense:
+        refuse("G-FIELD", "%s: read ZERO dense per-iteration residual lines. "
+               "Refusing rather than grading on a reader that saw nothing."
+               % log["path"])
+    ok_all = True
+    rec = {}
+    for eq in REG_FIELD_EQNS:
+        v = dense.get(eq) or []
+        if len(v) < REG_FIELD_WINDOW:
+            print("  %-8s only %d dense samples (need %d) -> NOT A RESULT for "
+                  "want of evidence" % (eq, len(v), REG_FIELD_WINDOW))
+            rec[eq] = {"n": len(v), "verdict": "NOT A RESULT",
+                       "reason": "fewer than %d dense samples" % REG_FIELD_WINDOW}
+            ok_all = False
+            continue
+        win = v[-REG_FIELD_WINDOW:]
+        slope, scatter, resid = _logfit(win)
+        snr = abs(slope) * len(win) / scatter if scatter > 0 else float("inf")
+        trend_ok = snr <= REG_FIELD_TREND_SNR_MAX
+
+        # limb 2 statistics are computed and printed always, gated only if
+        # limb 1 passed.
+        ss = sum(r * r for r in resid)
+        lag1 = (sum(resid[i] * resid[i + 1] for i in range(len(resid) - 1)) / ss
+                if ss > 0 else 0.0)
+        d = [resid[i + 1] - resid[i] for i in range(len(resid) - 1)]
+        nalt = sum(1 for i in range(len(d) - 1) if d[i] * d[i + 1] < 0)
+        altfrac = nalt / (len(d) - 1) if len(d) > 1 else 0.0
+        alt_ok = (altfrac < REG_FIELD_ALT_FRAC_MAX
+                  and lag1 > REG_FIELD_LAG1_MIN)
+
+        if trend_ok:
+            eq_ok = alt_ok
+            note = "" if alt_ok else "  <-- ALTERNATING (period-2 limit cycle)"
+        else:
+            eq_ok = False
+            note = "  <-- STILL DESCENDING (limb 2 computed, not gated)"
+        ok_all = ok_all and eq_ok
+        print("  %-8s trend SNR = %8.3f (<= %g) %-4s | alt-frac = %.3f (< %g) "
+              "| lag-1 = %+.3f (> %g) %s"
+              % (eq, snr, REG_FIELD_TREND_SNR_MAX, "OK" if trend_ok else "FAIL",
+                 altfrac, REG_FIELD_ALT_FRAC_MAX, lag1, REG_FIELD_LAG1_MIN, note))
+        rec[eq] = {"n": len(v), "window": REG_FIELD_WINDOW,
+                   "log10_slope_per_iter": slope, "scatter": scatter,
+                   "trend_snr": snr, "trend_ok": trend_ok,
+                   "alt_frac": altfrac, "lag1": lag1, "alt_ok": alt_ok,
+                   "verdict": "PASS" if eq_ok else "NOT A RESULT"}
+    report.setdefault("G-FIELD", {})[level] = rec
+    print("  G-FIELD %s: %s" % (level, "OK" if ok_all else "NOT A RESULT"))
+    return ok_all
+
