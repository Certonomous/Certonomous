@@ -78,4 +78,4 @@
-declare -A COARSEN_PASSES=( [L3]=2 [L2]=1 [L1]=0 )
-declare -A N_LAYERS=(       [L3]=17 [L2]=33 [L1]=65 )
-declare -A WANT_CELLS=(     [L3]=99840 [L2]=798720 [L1]=6389760 )
-declare -A WANT_WING=(      [L3]=6240  [L2]=24960  [L1]=99840   )
+declare -A COARSEN_PASSES=( [L3]=2 [L2]=1 [L1]=0 [AR1]=2 )
+declare -A N_LAYERS=(       [L3]=17 [L2]=33 [L1]=65 [AR1]=65 )
+declare -A WANT_CELLS=(     [L3]=99840 [L2]=798720 [L1]=6389760 [AR1]=399360 )
+declare -A WANT_WING=(      [L3]=6240  [L2]=24960  [L1]=99840   [AR1]=6240   )

# NOTE ON THE ONE COLLISION WORTH SEEING BEFORE THIS RUNS:
# AR1 and L3 share COARSEN_PASSES=2 and WANT_WING=6240 -- the SAME c2 surface --
# and differ only in N_LAYERS (65 vs 17) and therefore WANT_CELLS (399,360 vs
# 99,840).  That is the point of AR1 and it is exactly the controlled experiment.
# The runner's own PREPARE guard asserts BOTH cells AND wing faces, so the pair
# still identifies the level uniquely; neither alone does.  Its comment at
# a3gc_run.sh:272 ("CELL COUNT ALONE DOES NOT IDENTIFY A LEVEL") now holds in
# the other direction too, and the paired assertion is what makes it safe.
# WD = "$OUT/A3GC-AR1", a fresh root; G-COLD refuses it if a time dir exists.
# a3gc_genmesh.sh needs no --levels validation change: LEVELS is a free string.
