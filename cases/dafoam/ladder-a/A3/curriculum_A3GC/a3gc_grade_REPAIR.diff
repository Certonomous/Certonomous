+        print("--- VERDICT_SEVERITY census: every token in the fixed vocabulary ---")
+        print("  ordering (worst-first): %s" % " < ".join(VERDICT_SEVERITY))
+        for t in VERDICTS:
+            solo = compose_verdicts({"only": t})
+            pair = compose_verdicts({"other": "PASS", "only": t})
