REPAIR B -- READER SIDE.  UNBLOCKS THE EXISTING LEDGER.  CARRIES A REAL HAZARD.
-------------------------------------------------------------------------------
--- a/cases/dafoam/ladder-a/A6/curriculum_D8G/d8g_grade.py
+++ b/cases/dafoam/ladder-a/A6/curriculum_D8G/d8g_grade.py
@@ -386,6 +386,13 @@

+# A REFUSED LAUNCH IS A STRUCTURED, SELF-DECLARING RECORD, NOT GARBAGE.
+# d8g_run_arm.sh's LA.4 block writes it ON PURPOSE and states in the line
+# beside it that "no grading may read it".  It is matched EXACTLY -- the
+# `launched: false` token AND a `launch_rc=` field -- so a genuinely malformed
+# row still falls through to the refusal below.  It is COUNTED, NAMED IN THE
+# OUTPUT, AND NEVER TREATED AS AN ARM.
+REFUSED_LAUNCH_RE = re.compile(r"^ARM=(?P<ARM>\S+)\s+ROW=\S+\s+IMG=\S+\s+DIGEST=\S+\s+"
+                               r"launched:\s+false\s+reason=\[.*\]\s+launch_rc=(?P<launch_rc>-?\d+)\s")
+
 def read_ledger(path):
     if not os.path.isfile(path):
         refuse("ledger", {"absent": path})
     rows = {}
+    refused_launches = []
     for line in open(path, errors="replace"):
         if not line.startswith("ARM="):
             continue
+        rl = REFUSED_LAUNCH_RE.match(line)
+        if rl:
+            refused_launches.append({"ARM": rl.group("ARM"),
+                                     "launch_rc": int(rl.group("launch_rc")),
+                                     "raw": line.strip()[:300]})
+            continue
         m = LEDGER_RE.search(line)
         if not m:
             refuse("ledger", {"row_unparseable": line.strip()[:300],
                               "note": "PRESENT-BUT-GARBAGE row: refused, never skipped"})

  ... and, at the foot of read_ledger(), BEFORE `return rows`:

+    # A REFUSED LAUNCH IS NOT ERASED BY A LATER SUCCESS.  Every arm that has
+    # one is reported in the output with its launch_rc, and an arm that has a
+    # refused launch AND NO COMPLETED ROW is a REFUSAL, not a silent absence.
+    for rl in refused_launches:
+        if rl["ARM"] not in rows:
+            refuse("ledger", {"refused_launch_and_no_completed_row": rl["ARM"],
+                              "launch_rc": rl["launch_rc"], "raw": rl["raw"],
+                              "note": "the solver's first artifact never appeared and nothing "
+                                      "else was recorded for this arm"})
+    if refused_launches:
+        rows["__refused_launches__"] = refused_launches
     return rows

