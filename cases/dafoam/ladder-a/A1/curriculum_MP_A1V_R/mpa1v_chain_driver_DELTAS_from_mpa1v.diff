+# ---- L-504 PATH-EXISTENCE FIXPOINT (the MP-A1V-R delta) -----------------------
+# ALL_PINS_MATCH (md5) and the pin-integrity dry-run are BLIND to a launcher that
+# REFERENCES a staged instrument under a name different from the one actually
+# staged -- the exact defect that halted MP-A1V at FV-S (launcher referenced
+# $BASE/mpa1_age_guard.py while the driver staged mpa1v_age_guard.py).  This guard
+# PARSES the launcher for every `$BASE/mpa1*.{py,sh}` runtime reference, resolves
+# $BASE, and asserts each exists post-stage -- so a rename mismatch aborts rc=4
+# HERE, before any arm, instead of at the first solver arm hours later.  It is a
+# NAME check, not an md5 check, and is the guard the D9successor/MP-A1V L-504
+# incidents show md5 pins cannot provide.
+_missing=0
+for _ref in $(grep -oE '\$BASE/mpa1v?_[a-zA-Z_]+\.(py|sh)' "$LAUNCHER" | sort -u); do
+  _path="${_ref/\$BASE/$BASE}"
+  if [ ! -f "$_path" ]; then
+    echo "ABORT PATH-FIXPOINT launcher references $_ref but $_path is ABSENT post-stage (L-504 rename mismatch)"
+    _missing=1
+  fi
+done
+[ "$_missing" -eq 0 ] || { echo "chain=ABORT reason=path_fixpoint stamp=$(date -u +%Y%m%dT%H%M%SZ)" >> "$STATUS"; exit 4; }
+# Name-consistency: the launcher's G-ROOT.5 double-run guard READS the driver's
+# pidfile; both MUST name it identically or the guard is silently defeated.
+grep -q "PIDFILE=\"\$BASE/$(basename "$PIDFILE")\"" "$LAUNCHER" \
+  || { echo "ABORT PATH-FIXPOINT launcher/driver pidfile name mismatch ($(basename "$PIDFILE"))"; exit 4; }
+echo "MPA1V_PATH_FIXPOINT_OK every launcher \$BASE/mpa1*.{py,sh} ref exists post-stage; pidfile name agrees"
