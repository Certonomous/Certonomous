+# ===========================================================================
+# G-SO1A -- SO-1b's REGISTERED DEPENDENCY ON SO-1a, AND ITS NO-LAUNCH BRANCH.
+#
+# SO-1b optimises using the gradients SO-1a finite-difference verifies.  The
+# dependency is registered in PREREGISTRATION.md section 1a and it is EVALUATED
+# HERE, before the run root is created and before any container starts, so that
+# a failed SO-1a costs SO-1b ZERO core-minutes.
+#
+# WHAT IS CHECKED, and why it is NOT the item verdict.  SO-1a's REGISTERED
+# PREDICTED OUTCOME is item `GATE FAIL` -- its SHIPPED row is predicted to fail
+# band D at shape[6] (SO-1a P5), and that failure is the finding, not a defect.
+# Gating SO-1b on SO-1a's ITEM verdict would therefore kill SO-1b in exactly the
+# case SO-1a expects.  What SO-1b actually needs is narrower and is named here:
+# the PATCHED row's objective gradient G5 and its CONSTRAINT gradient G5c must
+# both read PASS, because those are the gradients the constrained optimiser
+# consumes.  SO-1a section 6 P6 says the same thing from the other side: "a MISS
+# means SO-1b cannot be registered as a constrained optimisation on this
+# gradient and the ladder stops at SO-1a."
+#
+# THREE OUTCOMES, all registered before compute:
+#   rc=0  PATCHED row PASS on G5 and G5c  -> the chain proceeds
+#   rc=7  the grade exists and the PATCHED row is not PASS -> NO-LAUNCH CLOSE,
+#         ZERO core-minutes, item verdict BLOCKED
+#   rc=7  the grade is absent or unreadable -> NO-LAUNCH CLOSE, ZERO
+#         core-minutes, item verdict BLOCKED.  An unreadable dependency is not
+#         a licence to proceed.
+# The wrapper's own bounded wait handles the case where SO-1a never reaches its
+# last arm at all (that path closes rc=6 BLOCKED, also at zero compute).
+# ===========================================================================
+SO1A_ROOT=/home/ubuntu/certonomous-runs/CURRICULUM-SO1a-a1-naca0012-dragmin-gradient
+SO1A_FP="$SO1A_ROOT/F-P/so1a_F.json"
+GSO1A_OUT="$HERE/G_SO1A.$(date -u +%Y%m%dT%H%M%SZ).txt"
+GSO1A_VERDICT=$(python3 - "$SO1A_ROOT" <<'GSO1A'
+# Read SO-1a's OWN frozen grade artefact and answer ONE question: is the
+# PATCHED row PASS on BOTH G5 (dCD/dx, the objective) and G5c (dCL/dx, the
+# equality constraint)?  Those are the two gradients a constrained optimiser
+# consumes.  The reading is taken on TWO CHANNELS -- the per-gate verdicts under
+# gates.G5_PATCHED, and the composed row verdict under rows.PATCHED -- and a
+# DISAGREEMENT BETWEEN THE CHANNELS REFUSES.  SO-1a section 3 composes the row
+# as PASS iff G5 and G5c are both PASS, so the two channels must agree; if they
+# do not, the artefact is not the one this branch was registered against.
+import glob, json, os, sys
+root = sys.argv[1]
+grades = sorted(glob.glob(os.path.join(root, "SO1a_grade_*.json")))
+if not grades:
+    print("REFUSE no_SO1a_grade_json_under=%s" % root); raise SystemExit(0)
+path = grades[-1]
+try:
+    with open(path) as fh:
+        G = json.load(fh)
+except Exception as exc:                                          # noqa: BLE001
+    print("REFUSE unreadable_grade=%s err=%r" % (os.path.basename(path), exc)); raise SystemExit(0)
+gates = G.get("gates") or {}
+gp = gates.get("G5_PATCHED")
+if not isinstance(gp, dict):
+    print("REFUSE no_gates.G5_PATCHED in=%s" % os.path.basename(path)); raise SystemExit(0)
+def v(d):
+    return d.get("verdict") if isinstance(d, dict) else d
+g5 = v(gp.get("G5_CD"))
+g5c = v(gp.get("G5c_CL"))
+row_gate = gp.get("row_verdict")
+row_top = (G.get("rows") or {}).get("PATCHED")
+if row_gate != row_top:
+    print("REFUSE channel_disagreement gates.G5_PATCHED.row_verdict=%r rows.PATCHED=%r file=%s"
+          % (row_gate, row_top, os.path.basename(path))); raise SystemExit(0)
+ok = (g5 == "PASS" and g5c == "PASS" and row_gate == "PASS")
+print("%s grade=%s G5_CD=%s G5c_CL=%s row_PATCHED=%s item=%s"
+      % ("PROCEED" if ok else "REFUSE", os.path.basename(path), g5, g5c, row_gate, G.get("verdict")))
+GSO1A
+)
