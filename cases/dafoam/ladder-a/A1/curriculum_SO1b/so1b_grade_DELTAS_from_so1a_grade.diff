+        return out
+    txt = open(path, errors="replace").read()
+    ex = re.findall(r"^(EXIT:.*)$", txt, re.M)
+    it = re.findall(r"^Number of Iterations\.*:\s*(\d+)\s*$", txt, re.M)
+    if ex:
+        out["exit_line"] = ex[-1].strip()
+    if it:
+        out["majors"] = int(it[-1])
+    return out
