     awk -v v="$6" '/^endTime/{$0="endTime         "v";"} {print}' "$sd/controlDict" > "$sd/controlDict.t1" && mv "$sd/controlDict.t1" "$sd/controlDict" || { echo "D6RF9_LEG_ABORT leg=$1 endTime set failed at $sd"; return 5; }
