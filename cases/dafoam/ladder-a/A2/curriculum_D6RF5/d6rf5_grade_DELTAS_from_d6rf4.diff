+def coefficient_equality_check():
+    """PREREGISTRATION.md section 11 item 4, EXECUTABLE.  Reads the frozen
+    d6rf5_fvSchemes_LIMITED and returns the laplacian and snGrad non-orthogonal
+    correction coefficients with `equal` set iff BOTH are 0.333 ([W1]: a
+    mismatched coefficient causes subtle residual errors difficult to diagnose).
+    Existence asserted before any read; REFUSES if the file is absent or a
+    coefficient is unreadable.  The EQUALITY itself is folded by G-SCHEME and by
+    --freeze-selfcheck, so a lane sees the numbers rather than only a boolean."""
+    path = os.path.join(HERE, G_SCHEME_FILE)
+    if not os.path.isfile(path):
+        refuse("COEFF_EQUALITY", {"fvSchemes_absent": path})
+    txt = open(path, errors="replace").read()
+    lap = re.search(r'laplacianSchemes\s*\{[^}]*?default\s+Gauss\s+linear\s+'
+                    r'limited\s+corrected\s+([0-9.]+)\s*;', txt, re.S)
+    sng = re.search(r'snGradSchemes\s*\{[^}]*?default\s+limited\s+corrected'
+                    r'\s+([0-9.]+)\s*;', txt, re.S)
+    if not lap or not sng:
+        refuse("COEFF_EQUALITY",
+               {"path": path, "laplacian_found": bool(lap),
+                "snGrad_found": bool(sng),
+                "note": "the limited-correction coefficient could not be read "
+                        "from one or both blocks"})
+    lc, sc = float(lap.group(1)), float(sng.group(1))
+    return {"laplacian_coeff": lc, "snGrad_coeff": sc,
+            "registered_coeff": G_SCHEME_COEFF,
+            "equal": (lc == sc == G_SCHEME_COEFF),
+            "file": G_SCHEME_FILE, "path": path}
