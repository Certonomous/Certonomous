+# =================== THE REGISTERED PRESENT-BUT-EMPTY DETECTOR ===============
+def points_empty_by_primal_raise(path, point=PLANT_POINT):
+    """D6RF7's ONE class of DELTA, and the ONE detector of the registered
+    present-but-empty product state.  Returns a detail dict when the artefact
+    is PRESENT ON DISK but carries NO CD to plant into BECAUSE THE PRIMAL RAISED
+    BY DESIGN (`primal_raised` truthy), else None.
+
+    WHY THIS EXISTS.  `P_conv` is the convergence probe: its registered
+    prediction is that the baseline primal FAILS G-CONV's floor, so DAFoam
+    raises `Primal solution failed!` after `End` and the producer's guard STILL
+    writes its product -- with `points = {}` and `primal_raised = True`
+    (d6rf7_fd_endpoint.py).  That present-but-empty state is the SAME
+    "nothing to plant into" condition as a file that never appeared, and it must
+    be handled the SAME WAY file-absence is: the control is NOT EXERCISED and
+    every CD-dependent gate reads NOT A RESULT for want of an input.  D6RF6
+    handled only file-ABSENCE and HARD-REFUSED here (points_present=[]), which
+    stopped grading before it could reach G-CONV and produce the very verdict
+    the probe predicts.  This detector is that gap closed.
+
+    FAIL-CLOSED.  A product whose points are empty WITHOUT `primal_raised` set
+    is NOT excused here -- it returns None and falls through to the reader's
+    own refusal.  Only the REGISTERED failure path (primal raised by design) is
+    treated as NOT EXERCISED; an unexpected empty product still refuses.  The
+    detection is read FROM THE ARTEFACT, never assumed.  This is the ONE
+    function both the control and the grader consult, so the state the control
+    excuses is byte-for-byte the state the gates route to no-input on."""
+    if path is None or not os.path.isfile(path):
+        return None
+    try:
+        with open(path) as fh:
+            doc = json.load(fh)
+    except (OSError, ValueError):
+        return None
+    pts = doc.get("points")
+    has_cd = (isinstance(pts, dict)
+              and isinstance(pts.get(point), dict)
+              and "CD" in pts[point])
+    if has_cd:
+        return None
+    if not doc.get("primal_raised"):
+        return None
+    return {"present_but_empty": True,
+            "points_present": sorted(pts) if isinstance(pts, dict) else None,
+            "registered_key_absent": "points.%s.CD" % point,
+            "primal_raised": True,
+            "primal_error": str(doc.get("primal_error"))[:400],
+            "n_primals_completed": doc.get("n_primals_completed"),
+            "legs_run": doc.get("legs_run"),
+            "artefact": path}
+
+
