+ARM_KIND = {"P1": "SCRIPT", "P2": "SOLVER", "O": "SOLVER", "ACC": "SOLVER",
+            "F3": "SOLVER"}
+SCRIPT_ARTEFACTS = {
+    "P1": ["d4_placement_rank0.json", "d4_placement_rank1.json",
