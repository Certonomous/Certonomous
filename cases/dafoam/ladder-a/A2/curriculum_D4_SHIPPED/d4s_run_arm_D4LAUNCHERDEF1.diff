+    echo "  neither row could be graded cleanly afterwards.  REFUSED."
+    exit 3
+  fi
+  if grep -aq "ROW=PATCHED" "$BASE/ledger.txt" 2>/dev/null; then
+    echo "ABORT G-ROOT.3 the ledger at $BASE/ledger.txt already carries PATCHED rows."
