+def _leg_log(path, p="1.30e-07", nut="1.10e-07",
+             cd="0.0184758685", cl="0.3999751808", fvmd5=None):
+    # THE INSTALL MARKER IS PART OF THE FIXTURE, because `gate_conv` now
+    # REFUSES a leg whose log does not show the registered fvSolution
+    # installed before it -- and a fixture that omitted the marker would test
+    # that refusal instead of the finiteness fold it is here for.  The md5 is
+    # read FROM THE GRADER'S OWN REGISTERED TABLE, never retyped.
+    with open(path, "w") as fh:
+        fh.write(LEG_LOG_CLEAN.format(
+            p=p, nut=nut, cd=cd, cl=cl,
+            fvmd5=fvmd5 or G.FVSOL_MD5[G.LEG_FVSOLUTION["L1"]]))
+    return path
+
