+    cases = (
+        ("G-CONV  p initRes    ", "conv", {"p": "nan"}, "L1.p.initRes"),
+        ("G-CONV  p initRes    ", "conv", {"p": "inf"}, "L1.p.initRes"),
+        ("G-CONV  nuTilda      ", "conv", {"nut": "-inf"}, "L1.nuTilda.initRes"),
+        ("G-SOLN  CD           ", "soln", {"cd": "nan"}, "L1.CD"),
+        ("G-SOLN  CL           ", "soln", {"cl": "inf"}, "L1.CL"),
