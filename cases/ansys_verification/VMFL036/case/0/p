FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    sphere      { type zeroGradient; }
    farField    { type freestreamPressure; freestreamValue uniform 0; }
    axis        { type empty; }
    front       { type wedge; }
    back        { type wedge; }
}
