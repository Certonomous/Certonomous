FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (1 0 0);

boundaryField
{
    sphere      { type noSlip; }
    farField    { type freestreamVelocity; freestreamValue uniform (1 0 0); }
    axis        { type empty; }
    front       { type wedge; }
    back        { type wedge; }
}
