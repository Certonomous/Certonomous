FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }
scale 1;
// 90-degree planar dividing tee -- SOURCED geometry from the Ansys archive mesh
// node coordinates (VMFL010_WB.wbpz -> .../plarb_r4-1.cas.h5, dataset
// meshes/1/nodes/coords/1, 2176 nodes): domain x in [0,4], y in [0,6].
// Main channel width W=1 (x in [0,1]), total length 6 = inlet leg 2 + junction 1
// + downstream leg 3. Branch width 1, length 3, on the x=1 wall over y in [2,3].
// Inlet at y=0 (x in [0,1]); mainOutlet at y=6 (x in [0,1], the 0.887 leg);
// branchOutlet at x=4 (y in [2,3]). NO adjustable parameter -- every dimension read
// from the archive. __N__ = cells per width W (r=2 triple: 20 / 40 / 80).
vertices
(
    (0 0 0) (1 0 0)          //  0  1   inlet line  y=0
    (0 2 0) (1 2 0)          //  2  3   junction bottom y=2
    (0 3 0) (1 3 0)          //  4  5   junction top    y=3
    (0 6 0) (1 6 0)          //  6  7   main outlet     y=6
    (4 2 0) (4 3 0)          //  8  9   branch outlet   x=4
    (0 0 1) (1 0 1)          // 10 11   z=1 (unit depth)
    (0 2 1) (1 2 1)          // 12 13
    (0 3 1) (1 3 1)          // 14 15
    (0 6 1) (1 6 1)          // 16 17
    (4 2 1) (4 3 1)          // 18 19
);
blocks
(
    hex ( 0  1  3  2 10 11 13 12) inletleg   (__N__  __2N__ 1) simpleGrading (1 1 1)
    hex ( 2  3  5  4 12 13 15 14) junction   (__N__  __N__  1) simpleGrading (1 1 1)
    hex ( 4  5  7  6 14 15 17 16) mainleg    (__N__  __3N__ 1) simpleGrading (1 1 1)
    hex ( 3  8  9  5 13 18 19 15) branchleg  (__3N__ __N__  1) simpleGrading (1 1 1)
);
edges ();
boundary
(
    inlet        { type patch; faces ( (0 1 11 10) ); }            // y=0
    mainOutlet   { type patch; faces ( (6 7 17 16) ); }            // y=6 straight-through
    branchOutlet { type patch; faces ( (8 9 19 18) ); }            // x=4 branch end
    walls        { type wall;  faces (
                       (0 2 12 10) (2 4 14 12) (4 6 16 14)         // x=0 left wall, full height
                       (1 3 13 11)                                 // x=1 wall, inlet leg y[0,2]
                       (5 7 17 15)                                 // x=1 wall, downstream leg y[3,6]
                       (3 8 18 13)                                 // branch bottom y=2
                       (5 9 19 15)                                 // branch top y=3
                   ); }
    frontBack    { type empty; faces (
                       (0 1 3 2)   (10 11 13 12)
                       (2 3 5 4)   (12 13 15 14)
                       (4 5 7 6)   (14 15 17 16)
                       (3 8 9 5)   (13 18 19 15)
                   ); }
);
mergePatchPairs ();
