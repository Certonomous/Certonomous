FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
// CLASS DEFAULT, carried unchanged from VMFL054-R3 (same flow class), except that
// nNonOrthogonalCorrectors stays 0 because this mesh is a PERFECTLY ORTHOGONAL cube of
// cubic cells (checkMesh max non-orthogonality is gated at 0 in stage 2).
//
// SOLVER TOLERANCE IS STRICTLY TIGHTER THAN THE GATE (Case Protocol sec.1, the T23G2Rn2
// rule).  The gate reads a grid-convergence functional whose level-to-level differences
// are expected at 1e-3 .. 1e-2 relative; residualControl at p 1e-08 / U 1e-09 leaves the
// iterative error orders below that, and the comparator additionally CHECKS the Case
// Protocol sec.5 condition that iterative error is at least 10x smaller than the
// level-to-level difference.  A tolerance equal to a gate would void the rung.
solvers
{
    p { solver GAMG; smoother GaussSeidel; tolerance 1e-10; relTol 0.01; }
    U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-11; relTol 0.1; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent      yes;
    // Closed cavity: no fixed-pressure patch anywhere, so pin the pressure level.
    pRefCell        0;
    pRefValue       0;
    residualControl { p 1e-08; U 1e-09; }
}
relaxationFactors { equations { U 0.9; p 0.9; } }
