    // ===================== THE STATIONARITY MONITOR ==========================
    // Case Protocol sec.4 requires stationarity of the graded quantity over a
    // window.  One point (the cube's geometric centre) every 10 iterations is the
    // monitor channel; it is NOT a gate reader and the comparator never grades it.
    centreHistory
    {
        type            probes;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   10;
        interpolationScheme cellPoint;
        fields          (U);
        probeLocations  ( (0.5 0.5 0.5) );
    }
