/*--------------------------------*- C++ -*----------------------------------*\
  VMFL005 -- Poiseuille flow in a pipe (Ansys FD Verification Manual, p. 25).
  Axisymmetric WEDGE, single cell thick, wedge front/back patches -- the
  canonical v2606 axisymmetric idiom (copied from
  tutorials/compressible/rhoCentralFoam/LadenburgJet60psi/system/blockMeshDict,
  single radial block from axis r=0 to wall r=R).

  Pipe axis is +x (flow direction), 0 <= x <= L = 0.1 m.  The wedge is symmetric
  about the x-y plane, half-angle 2.5 deg (5 deg total).  The wall vertices are
  placed at EXACT radius R:  y_w = R cos(2.5 deg), z_w = +/- R sin(2.5 deg), so
  |(y_w, z_w)| = R = 0.00125 m to machine precision (NOT y=R, z=R tan(a), which
  would put the wall at R/cos(a) and bias Hagen-Poiseuille's 1/R^4 by ~0.19 %).

  __NX__  axial cells (x)
  __NR__  radial cells (r), uniform.  aspect ratio dx/dr = 80*__NR__/__NX__.
  Substituted by run_vmfl005.sh; this template is never edited by a run.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mergeType points;   // Wedge geometry -- merge coincident axis points

scale   1;

// R = 0.00125 m, half-angle 2.5 deg:
//   y_w = R cos(2.5 deg) = 0.00124881027697732
//   z_w = R sin(2.5 deg) = 5.452423420667e-05
vertices
(
    (0.0  0                     0                    )   // 0  inlet  axis
    (0.1  0                     0                    )   // 1  outlet axis
    (0.0  0.00124881027697732  -5.452423420667e-05  )   // 2  inlet  wall back (z<0)
    (0.1  0.00124881027697732  -5.452423420667e-05  )   // 3  outlet wall back
    (0.0  0.00124881027697732   5.452423420667e-05  )   // 4  inlet  wall front (z>0)
    (0.1  0.00124881027697732   5.452423420667e-05  )   // 5  outlet wall front
);

blocks
(
    hex (0 1 3 2  0 1 5 4) (__NX__ __NR__ 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 2 4 0)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 3 5 1)
        );
    }
    walls
    {
        type wall;
        faces
        (
            (2 3 5 4)
        );
    }
    wedge1
    {
        type wedge;
        faces
        (
            (0 2 3 1)
        );
    }
    wedge2
    {
        type wedge;
        faces
        (
            (0 1 5 4)
        );
    }
);

mergePatchPairs
(
);

// ************************************************************************* //
