FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    p_rgh { solver PCG; preconditioner DIC; tolerance 1e-12; relTol 0.01; }
    "(U|h|e|k|epsilon|omega)"
    { solver PBiCGStab; preconditioner DILU; tolerance 1e-12; relTol 0.1; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    pRefCell        0;
    pRefValue       0;
    rhoMin          0.5;
    rhoMax          2.0;
    residualControl { }          // NO early exit: every level runs the SAME endTime iterations
}
relaxationFactors
{
    fields  { p_rgh 0.7; rho 1.0; }
    equations { U 0.3; "(h|e)" 0.3; }
}
