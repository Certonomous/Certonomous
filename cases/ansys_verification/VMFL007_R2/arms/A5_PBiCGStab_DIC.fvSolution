FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    p { solver PBiCGStab; preconditioner DIC; tolerance 1e-12; relTol 0.01; }
    U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-12; relTol 0.1; nSweeps 2; }
}
// NO residualControl: rule 4 requires last time == endTime, so the run is a
// FIXED iteration count and convergence is a graded CLAUSE, not an exit.
SIMPLE { nNonOrthogonalCorrectors 0; consistent no; }
relaxationFactors { fields { p 0.3; } equations { U 0.7; } }
