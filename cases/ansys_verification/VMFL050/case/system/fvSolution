/*--------------------------------*- C++ -*----------------------------------*\
  VMFL050 -- laplacianFoam.  Linear conduction: PCG with DIC preconditioner,
  tight tolerance so the linear-solve error is far below the discretisation
  error the triple measures.  No SIMPLE loop (transient, one solve per step).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    T
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-12;
        relTol          0;
    }
}

SIMPLE
{
}

// ************************************************************************* //
