/*--------------------------------*- C++ -*----------------------------------*\
  VMFLGPU005 -- EVERY linear solve routed through petsc4Foam. __MATTYPE__ /
  __VECTYPE__ substituted by run_vmflgpu005.sh (GPU arm aijcusparse/cuda; forced-
  CPU control aij/standard). BOTH ARMS OTHERWISE BYTE-IDENTICAL -- same mesh,
  schemes, relaxation, outer loop and iteration count. That identity is the whole
  basis on which limb B is a statement about WHERE the linear algebra ran.

  p_rgh takes CG + GAMG (Part-1 finding: on this stiff buoyant Poisson, cuSPARSE
  CG with Jacobi took 327 iters vs 9 with GAMG; GAMG runs on the GPU with 100%
  KSPSolve GPU flops). U/T/k/omega take BiCGStab + Jacobi. The PC TYPE is IDENTICAL
  between the two arms; only mat_type/vec_type differ.
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    p_rgh
    {
        solver petsc;
        petsc
        {
            options { ksp_type cg; pc_type gamg; mat_type __MATTYPE__; vec_type __VECTYPE__; }
            caching { matrix { update always; } preconditioner { update always; } }
        }
        tolerance 1e-9; relTol 0.01;
    }
    "(U|T|k|omega)"
    {
        solver petsc;
        petsc
        {
            options { ksp_type bcgs; pc_type jacobi; mat_type __MATTYPE__; vec_type __VECTYPE__; }
            caching { matrix { update always; } preconditioner { update always; } }
        }
        tolerance 1e-9; relTol 0.1;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    pRefCell  0;
    pRefValue 0;
    // NO residualControl: the run reaches endTime, so rule 4's "last time ==
    // endTime" bites and BOTH ARMS TAKE THE SAME OUTER ITERATION COUNT -- the
    // condition that makes limb B a statement about the linear algebra alone.
}
relaxationFactors
{
    fields    { p_rgh 0.7; }
    equations { U 0.3; T 0.5; "(k|omega)" 0.7; }
}
// ************************************************************************* //
