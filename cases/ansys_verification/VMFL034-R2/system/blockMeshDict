(
    patch inlet
    (
        (3 11 13 5)
    )
    patch outlet
    (
        (2 4 12 10)
    )
    wall topWall
    (
        (7 6 14 15)
    )
    wall bottomWall
    (
        (0 1 9 8)
    )
    wall fixedWalls
    (
        (0 3 11 8)     // left, band 0
        (5 7 15 13)    // left, band 2
        (1 2 10 9)     // right, band 0
        (4 6 14 12)    // right, band 2
    )
    empty frontAndBack
    (
        (0 3 2 1)      // z=0, band 0
        (3 5 4 2)      // z=0, band 1
        (5 7 6 4)      // z=0, band 2
        (8 9 10 11)    // z=0.01, band 0
        (11 10 12 13)  // z=0.01, band 1
        (13 12 14 15)  // z=0.01, band 2
    )
);

