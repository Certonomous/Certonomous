FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

// rhoCentralFoam is explicit in the convective fluxes; the diffusive correctors are
// implicit. VMFL045 row #5 lesson: a VISCOUS rhoCentralFoam case needs an energy
// solver entry matching the thermo `energy` keyword. thermophysicalProperties sets
// energy = sensibleInternalEnergy, so the solved energy variable is `e`; the entry is
// written "(e|h)" so the dictionary is complete under either energy form.

solvers
{
    "(rho|rhoU|rhoE)"
    {
        solver          diagonal;
    }

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-09;
        relTol          0.01;
    }

    "(e|h)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-10;
        relTol          0;
    }

    "(k|omega)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-10;
        relTol          0;
    }
}
