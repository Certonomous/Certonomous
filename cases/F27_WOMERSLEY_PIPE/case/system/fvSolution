FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
// TOLERANCES ARE DERIVED FROM THIS LADDER'S OWN PREDICTED FINE-LEVEL ERROR
// (L-346), NOT INHERITED FROM F21.  See exact_f27.py::
// control_L346_resolution_derived_from_this_ladder, which DRIVES the bound:
// steps_fine (2688) x max(p_tol, U_tol) = 2.688e-07, against a predicted fine
// E2 of 1.285e-04 -- a factor 478 below, where L-346 demands one order.
solvers
{
    p      { solver PCG; preconditioner DIC; tolerance 1e-10; relTol 0; }
    pFinal { $p; relTol 0; }
    "(U|UFinal)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-12; relTol 0; }
}
PIMPLE
{
    nOuterCorrectors        1;      // PISO mode
    nCorrectors             2;
    nNonOrthogonalCorrectors 1;     // the butterfly is non-orthogonal; see fvSchemes
    momentumPredictor       yes;
    pRefCell                0;
    pRefValue               0;
}
