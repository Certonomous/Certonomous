FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
// REVISED 2026-09-12 after a SMOKE TEST STALLED INSIDE THE FIRST PRESSURE SOLVE.
// Two defects, both mine, both caught before any rank-hours were spent:
//   1. p tolerance was 1e-9 -- the compressible external-aero tutorial
//      (compressible/rhoSimpleFoam/aerofoilNACA0012) uses 1e-6.  A thousand times tighter,
//      per SIMPLE iteration, on 1.16 M cells.
//   2. `transonic yes` adds div(phid,p) and makes the p matrix ASYMMETRIC.  GAMG is a
//      symmetric-matrix method; PBiCGStab with DILU is not, and is what an asymmetric p
//      equation needs.
// nNonOrthogonalCorrectors drops 1 -> 0 (the tutorial's value; the mesh is checkMesh-OK)
// and pMinFactor/pMaxFactor are the compressible limiters that tutorial carries.
solvers
{
    p
    {
        solver          PBiCGStab;   // ASYMMETRIC: transonic yes => div(phid,p)
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.01;
    }
    "(U|e|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;
        relTol          0.1;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    transonic       yes;
    consistent      no;
    pMinFactor      0.1;
    pMaxFactor      2;
    // residualControl DELIBERATELY ABSENT: an early residual exit satisfies neither
    // `last == endTime` nor the ExecutionTime-count clause of rule 4, so a CONVERGED run
    // would be graded INCOMPLETE.  G-S1 READS the residuals; it does not stop the run.
}
relaxationFactors
{
    fields { p 0.3; rho 0.01; }
    equations { U 0.3; e 0.7; "(k|omega)" 0.7; }   // tutorial values; U 0.3 is the conservative one
}
