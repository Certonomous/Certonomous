/*--------------------------------*- C++ -*----------------------------------*\
  F24 -- Prandtl-Meyer corner.  FIXED time step (dt/h = 0.04 at every level),
  time-marched to endTime = 4 (4.7 flow-through times of the 2-unit domain at
  u1 = 2.366); checkpoints every 0.1 -> 40 samples for the plateau series.
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }

application     rhoCentralFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         4;             // must equal exact_f24.T_END
deltaT          __DT__;        // FIXED; refines by 2 with h (dt/h = 0.04 at every level)
writeControl    runTime;
writeInterval   0.1;           // 40 checkpoints: the plateau series (must equal exact_f24.WRITE_DT)
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   10;
runTimeModifiable false;
adjustTimeStep  no;            // dt is registered, never adapted
maxCo           0.2;
maxDeltaT       1;
