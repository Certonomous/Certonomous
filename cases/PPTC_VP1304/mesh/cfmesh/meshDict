// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// D1: the case's own admitted surface, built by the registered G0 step.  A file name,
//     not a recipe change.  Base read "ship5415-hull-and-box.ftr".
surfaceFile "PPTC-body-and-domain.ftr";

// D2: 150 -> 0.02.  The REGISTERED background cell, 20.00 mm, in metres
//     (log.makeSnappy:2 of F360_coarse; registered import scale 1e-3, GEOMETRY_ADMISSION
//     _RECORD.md §2).  The base's units are its own STL's; ours are metres.
maxCellSize 0.02;

// D3: same field as the base, five entries instead of one.  The levels ARE the registered
//     snappy refinement levels (make_snappy.py:37-43), which are exact powers of two of
//     the 20 mm background: 2^5 -> 0.625 mm, 2^4 -> 1.25 mm, 2^3 -> 2.5 mm, 2^2 -> 5.0 mm.
//     refinementThickness carries the BASE DICTIONARY'S OWN RATIO 50/150 = 1/3 applied to
//     our maxCellSize: 0.02/3 = 6.6667e-3 m.  Not a new number -- the published one, scaled.
surfaceMeshRefinement
{
    blades
    {
        additionalRefinementLevels  5;
        surfaceFile "constant/triSurface/blades.stl";
        refinementThickness 6.6667e-3;
    }
    hub
    {
        additionalRefinementLevels  4;
        surfaceFile "constant/triSurface/hub.stl";
        refinementThickness 6.6667e-3;
    }
    cap
    {
        additionalRefinementLevels  4;
        surfaceFile "constant/triSurface/cap.stl";
        refinementThickness 6.6667e-3;
    }
    shaft
    {
        additionalRefinementLevels  3;
        surfaceFile "constant/triSurface/shaft.stl";
        refinementThickness 6.6667e-3;
    }
    shaftExtension
    {
        additionalRefinementLevels  2;
        surfaceFile "constant/triSurface/shaftExtension.stl";
        refinementThickness 6.6667e-3;
    }
}

// D10: ADDED 2026-09-13, PRE-COMPUTE, by amendment A1.  The REGISTERED volume refinement,
//      in cfMesh's own vocabulary.  FORMS COPIED, NOT INVENTED, from the shipped tutorial
//      tutorials/cartesianMesh/bunnyOctree/system/meshDict, sha256
//      da05baa6e65267a73680ab3325336a989a9f6fe72fc07e271bc72abb1497c487 (verbatim copy kept
//      beside this file as meshDict.bunnyOctree.PUBLISHED); the same `cone` form appears
//      independently in tutorials/pMesh/bunnyPoly/system/meshDict, sha256
//      3c0b3ec5dce746a6f79acf8009a4559498f86305449520fac83dd7cc0a7e3ee0.
//      A cone with radius0 == radius1 IS cfMesh's cylinder -- bunnyOctree's own ear1/ear2
//      use exactly that, and coneRefinement.C:106-118 interpolates the radius along the
//      axis, so equal radii give a right circular cylinder of finite extent.  cfMesh ships
//      no `cylinder` type.
//      SOURCE OF THE GEOMETRY: make_snappy.py:125-132 (searchableCylinder definitions) and
//      :151-153 (refinementRegions, levels ((1e15 4)) on both, against the 20.00 mm
//      background -> 1.25 mm).
//      LEVELS, NOT cellSize, AND THE REASON IS A TRAP IN THE PUBLISHED SOURCE:
//      objectRefinement.C:108-130 converts a requested cellSize to a level by halving from
//      maxCellSize WHILE cellSize <= s*(1+SMALL) -- one halving too many when the ratio is
//      an exact power of two.  Traced at maxCellSize 0.02: `cellSize 1.25e-3` yields
//      additionalRefinementLevels 5 and an achieved cell of 6.25e-4 m, a factor 2 FINER
//      than registered.  `additionalRefinementLevels 4` is cfMesh's own integer vocabulary,
//      is counted from the same maxCellSize, and reproduces the registered 1.25 mm EXACTLY.
//      refinementThickness is deliberately NOT set (default 0.0): refinement applies inside
//      the object only, which is the image of snappy's `mode inside; levels ((1e15 4))`.
//      NOT TRANSLATED: the 1.3D MRF zone.  It is a cellZone carrying the rotating-frame
//      source, not a refinementRegions entry (make_snappy.py:133-136, :154), and
//      objectRefinements cannot write a cellZone.  See D9(b) as struck.
//      DISCLOSED: no shipped tutorial combines surfaceMeshRefinement with objectRefinements.
//      Both are read by separate found()-guarded functions called in sequence from
//      meshOctreeCreator::createOctreeBoxes() -- refineBoxesIntersectingSurfaces() at
//      meshOctreeCreatorCreateOctreeBoxes.C:499 and refineBoxesContainedInObjects() at :525
//      -- so neither excludes the other, but the combination is not exhibited by a published
//      example.  Refusal limb R2 covers the outcome if that reading is wrong: BLOCKED, not
//      GATE FAIL.
objectRefinements
{
    bladeRegion
    {
        type        cone;
        additionalRefinementLevels  4;
        p0          (-0.100 0 0);
        radius0     0.1325;
        p1          (0.060 0 0);
        radius1     0.1325;
    }
    tipVortex
    {
        type        cone;
        additionalRefinementLevels  4;
        p0          (-0.250 0 0);
        radius0     0.130;
        p1          (0.030 0 0);
        radius1     0.130;
    }
}

// D4: the base's `anisotropicSources` Box, which squashes z by 0.3 to resolve a FREE
//     SURFACE, is REMOVED.  An open-water propeller test has no free surface.

// D5: patchBoundaryLayers -- the base's one hull patch becomes the four REGISTERED layer
//     patches of pre-registration §6.3 (make_snappy.py:47), and thicknessRatio 1.1 -> 1.2
//     is the registered §6.3 value.
//     AMENDED 2026-09-13 (A2.1): nLayers is 2, NOT the parent registration's 6.  cfMesh
//     builds the whole stack inside ONE octree cell by construction
//     (refineBoundaryLayersFunctions.C:684-714), so the layer count sets t1 and nothing
//     else.  At n=2, t1 = s_P/2.2 -> blades 0.2841 mm -> y+ ~ 51.5, INSIDE the registered
//     §6.3 wall-function window 30-60.  At n=6, t1 <= 0.0629 mm -> y+ ~ 11.4, OUTSIDE it,
//     at any first-layer height.  RUNG-LOCAL: the parent open-water registration's §6.3
//     nSurfaceLayers is untouched.
// D6: `maxFirstLayerThickness` is NOT in the base.  Keyword taken from the shipped cfMesh
//     tutorials multipleOrifices / singleOrifice / elbow_90degree.
//     AMENDED 2026-09-13 (A2.7): the values are the n=2 first-layer heights s_P/2.2,
//     rounded UP at the fifth significant figure (excess <= 3.2e-5 relative) so that the
//     min() PROVABLY cannot bind.  THE OLD 6-LAYER VALUES WOULD HAVE BOUND AT n=2 --
//     min(2.840909e-4, 1.2559e-4) = 1.2559e-4 on blades -- dragging t1 back to the 6-layer
//     value and defeating the ruling above.  IT IS PREDICTED NOT TO BIND --
//     refineBoundaryLayersFunctions.C:688-714 caps but never thickens.
boundaryLayers
{
    patchBoundaryLayers
    {
        blades
        {
            nLayers 2;
            thicknessRatio 1.2;
            maxFirstLayerThickness 2.8410e-04;
        }
        hub
        {
            nLayers 2;
            thicknessRatio 1.2;
            maxFirstLayerThickness 5.6819e-04;
        }
        cap
        {
            nLayers 2;
            thicknessRatio 1.2;
            maxFirstLayerThickness 5.6819e-04;
        }
        shaft
        {
            nLayers 2;
            thicknessRatio 1.2;
            maxFirstLayerThickness 1.1364e-03;
        }
    }

    // D7: ZERO DEVIATION.  optimiseLayer and every optimisationParameters value below are
    //     the base dictionary's own, unchanged.
    optimiseLayer 1;

    optimisationParameters
    {
        nSmoothNormals 3;
        maxNumIterations 2;
        featureSizeFactor 0.4;
        reCalculateNormals 1;
        relThicknessTol 0.1;
    }
}

// D8: `renameBoundary` is NOT in the base.  Keyword taken from the shipped cfMesh
//     tutorials elbow_90degree / multipleOrifices / singleOrifice.  It is required because
//     cfMesh names patches from the surface regions and the three flow boundaries must be
//     type `patch`, not `wall`, or wallDist measures a distance to the farfield.
//     The five body patch NAMES are already the registered ones (make_stl.py) and are
//     NOT renamed.
renameBoundary
{
    defaultName     domainWall;
    defaultType     wall;

    newPatchNames
    {
        "inlet.*"
        {
            type    patch;
            newName inlet;
        }

        "outlet.*"
        {
            type    patch;
            newName outlet;
        }

        "outerBoundary.*"
        {
            type    patch;
            newName outerBoundary;
        }
    }
}

