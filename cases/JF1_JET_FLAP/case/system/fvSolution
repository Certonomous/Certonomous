/*--------------------------------*- C++ -*----------------------------------*\
| JF1 -- SIMPLEC per Sanaa CASE 1 section 1.4.                                |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-09;
        relTol          0.01;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration on;
        agglomerator    faceAreaPair;
        nCellsInCoarsestLevel 20;
        mergeLevels     1;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.01;
        nSweeps         1;
    }
}

SIMPLE
{
    consistent                  yes;
    nNonOrthogonalCorrectors    1;

    residualControl
    {
        p           1e-06;
        U           1e-06;
        k           1e-06;
        omega       1e-06;
    }
}

// Sanaa CASE 1 section 1.4: "consistent yes; relaxation p 0.3 / U 0.7 /
// k,omega 0.7 (start)".  p is a FIELD relaxation in OpenFOAM (simpleFoam calls
// p.relax(), which reads relaxationFactors/fields); putting p under `equations`
// would silently apply NO p relaxation at all.
relaxationFactors
{
    fields
    {
        p           0.3;
    }
    equations
    {
        U           0.7;
        k           0.7;
        omega       0.7;
    }
}

