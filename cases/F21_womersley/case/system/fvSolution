FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    p      { solver PCG; preconditioner DIC; tolerance 1e-09; relTol 0; }
    pFinal { $p; relTol 0; }
    "(U|UFinal)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-12; relTol 0; }
}
PIMPLE
{
    nOuterCorrectors        1;      // PISO mode
    nCorrectors             2;
    nNonOrthogonalCorrectors 0;
    momentumPredictor       yes;
    pRefCell                0;
    pRefValue               0;
}
