/*--------------------------------*- C++ -*----------------------------------*\
| MRF_R1 nut. nutkWallFunction on no-slip walls; zeroGradient on the slip lid. |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    "(tankWall|tankBottom|baffles|shaft|impeller)"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    tankLid
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
