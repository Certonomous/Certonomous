/*--------------------------------*- C++ -*----------------------------------*\
| MRF_R1 mesh-quality controls for snappyHexMesh. maxNonOrtho 65 and           |
| maxInternalSkewness 4 align with MESH_STANDARD sec.3 hard gates (non-ortho   |
| <=70, skew <=4); checkMesh is the authority read back after the build.       |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      meshQualityDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

maxNonOrtho             65;
maxBoundarySkewness     4;
maxInternalSkewness     4;
maxConcave              80;
minVol                  1e-13;
minTetQuality           1e-15;
minArea                 -1;
minTwist                0.02;
minDeterminant          0.001;
minFaceWeight           0.02;
minVolRatio             0.01;
minTriangleTwist        -1;

nSmoothScale            4;
errorReduction          0.75;

relaxed
{
    maxNonOrtho         70;
}

// ************************************************************************* //
