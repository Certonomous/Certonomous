 # ------------------------------------------------------------------ the reader
+def first_delta_s(path, ncols, idx_ds):
+    """The first marched layer's deltaS, read from the log this instrument already reads.
+    It is the closest thing to s0 that the log itself carries, and it is what makes the
+    reference band comparable or not."""
+    with open(path) as f:
+        for line in f:
+            s = line.strip()
+            if not s or s.startswith('#'):
+                continue
+            t = s.split()
+            if len(t) != ncols or not re.fullmatch(r'\d+', t[0]):
+                continue
+            try:
+                return float(t[idx_ds])
+            except ValueError:
+                return None
+    return None
+
+
