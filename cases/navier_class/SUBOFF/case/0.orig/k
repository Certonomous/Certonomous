FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.00502167;

boundaryField
{
    inlet    { type fixedValue; value uniform 0.00502167; }
    outlet   { type inletOutlet; inletValue uniform 0.00502167; value uniform 0.00502167; }
    farfield { type zeroGradient; }
    hull     { type kqRWallFunction; value uniform 0.00502167; }
    axis     { type empty; }
    frontWedge { type wedge; }
    backWedge  { type wedge; }
}
