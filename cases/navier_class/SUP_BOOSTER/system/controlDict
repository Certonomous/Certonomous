FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application     rhoCentralFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         15000;    // graded run: pseudo-iterations to steady conical flow (plateau enforced by grader)
deltaT          1;
writeControl    runTime;
writeInterval   1000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;
adjustTimeStep  no;
maxCo           0.4;
maxDeltaT       1;
