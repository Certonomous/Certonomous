FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object U;
}
dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (694.40 0 0);
boundaryField
{
    inlet       { type fixedValue;    value uniform (694.40 0 0); }
    freestream  { type fixedValue;    value uniform (694.40 0 0); }
    outlet      { type zeroGradient; }
    cone        { type slip; }          // INVISCID slip wall (Euler) -- matches Taylor-Maccoll
    axis        { type empty; }
    front       { type wedge; }
    back        { type wedge; }
}
