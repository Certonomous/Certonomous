FoamFile{version 2.0;format ascii;class dictionary;location "system";object fvSolution;}
// CRM-WB D8G -- STAGE 1 OF THE REGISTERED STARTUP RAMP. Heavy relaxation only; the ALGORITHM
// is unchanged (consistent yes, transonic yes) because changing it is a different registered
// change and M6I measured what happens when it is altered casually.
solvers
{
    // PROBE P2 -- THE SINGLE REGISTERED CHANGE: NO GAMG ON THE PRESSURE SOLVE AT ALL.
    // V10's SIGFPE is in libOpenFOAM, not in the thermophysical model: the stack is
    // GAMGSolver -> Vcycle -> solveCoarsestLevel -> PBiCGStab::scalarSolve -> sumProd<double>.
    // sumProd faulting means the COARSEST-LEVEL AGGLOMERATED SYSTEM holds non-finite values or
    // products that overflow a double. That is the same cause as the very first finding of this
    // act -- GAMG running to its 1000-iteration ceiling for a 1.4x residual reduction on a grid
    // whose maximum aspect ratio is 4437. One cause, two symptoms: a coarse hierarchy that
    // cannot solve, first stalling and now overflowing.
    // PBiCGStab/DIC removes the coarse hierarchy from the problem entirely, so it is the
    // DEFINITIVE test of whether agglomeration is the cause rather than a tuning of it.
    // DILU, not DIC: the TRANSONIC pressure matrix is ASYMMETRIC because of div(phid,p), and DIC
    // is a symmetric-matrix preconditioner -- "Unknown asymmetric matrix preconditioner type DIC".
    // The V10 stack said so already: GAMG's coarsest level was solved with PBiCGStab, not PCG,
    // which it would use on a symmetric system.
    p       { solver PBiCGStab; preconditioner DILU; tolerance 1e-10; relTol 0.01; }
    "(U|e|h|nuTilda)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-11; relTol 0.01; }
    rho     { solver diagonal; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;
    transonic       yes;
    // CLAMPS DERIVED FROM THE REGISTERED CONDITION, NOT CHOSEN BY EYE (ADDENDUM 9).
    // A clamp catches NON-PHYSICAL excursions, so it must sit ABOVE every physically attainable
    // value. At M_inf 0.85 the TRUE stagnation pressure is p0/p_inf = (1+0.2*0.85^2)^3.5 =
    // 1.603819, i.e. 6427.135 Pa. The previous pMaxFactor 1.5 = 6011.092 Pa sat 6.5 % BELOW
    // STAGNATION, so every cell at or near the stagnation point was clamped every iteration from
    // iteration 1 -- a persistent non-physical forcing on a region that was not excursing.
    // The proof is this act's own isentropic initialiser, which reported its range as
    // [1750.771, 6427.135] Pa: its maximum IS p0 to six figures, and its minimum (the M=1.5 cap)
    // sat BELOW the old pMinFactor 0.5 = 2003.697 Pa. THE INITIAL FIELD WAS OUTSIDE THE CLAMP AT
    // BOTH ENDS BEFORE A SINGLE ITERATION RAN.
    pMinFactor      0.1;     // below the pocket minimum: at local M 2.6, p/p_inf = 0.0804
    pMaxFactor      2.0;     // above stagnation 1.6038 with x1.25 margin
    rhoMin          0.02;
    rhoMax          0.12;
    residualControl { p 1e-6; U 1e-6; e 1e-6; nuTilda 1e-6; }
}
relaxationFactors
{
    fields  { p 0.1; rho 0.01; }
    equations { U 0.3; e 0.3; h 0.3; nuTilda 0.3; }
}
