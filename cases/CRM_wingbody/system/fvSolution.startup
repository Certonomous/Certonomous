FoamFile{version 2.0;format ascii;class dictionary;location "system";object fvSolution;}
// CRM-WB D8G -- STAGE 1 OF THE REGISTERED STARTUP RAMP. Heavy relaxation only; the ALGORITHM
// is unchanged (consistent yes, transonic yes) because changing it is a different registered
// change and M6I measured what happens when it is altered casually.
solvers
{
    // PROBE P2 -- THE SINGLE REGISTERED CHANGE: NO GAMG ON THE PRESSURE SOLVE AT ALL.
    // V10's SIGFPE is in libOpenFOAM, not in the thermophysical model: the stack is
    // GAMGSolver -> Vcycle -> solveCoarsestLevel -> PBiCGStab::scalarSolve -> sumProd<double>.
    // sumProd faulting means the COARSEST-LEVEL AGGLOMERATED SYSTEM holds non-finite values or
    // products that overflow a double. That is the same cause as the very first finding of this
    // act -- GAMG running to its 1000-iteration ceiling for a 1.4x residual reduction on a grid
    // whose maximum aspect ratio is 4437. One cause, two symptoms: a coarse hierarchy that
    // cannot solve, first stalling and now overflowing.
    // PBiCGStab/DIC removes the coarse hierarchy from the problem entirely, so it is the
    // DEFINITIVE test of whether agglomeration is the cause rather than a tuning of it.
    p       { solver PBiCGStab; preconditioner DIC; tolerance 1e-10; relTol 0.01; }
    "(U|e|h|nuTilda)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-11; relTol 0.01; }
    rho     { solver diagonal; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      yes;
    transonic       yes;
    pMinFactor      0.5;
    pMaxFactor      1.5;
    rhoMin          0.02;
    rhoMax          0.12;
    residualControl { p 1e-6; U 1e-6; e 1e-6; nuTilda 1e-6; }
}
relaxationFactors
{
    fields  { p 0.1; rho 0.01; }
    equations { U 0.3; e 0.3; h 0.3; nuTilda 0.3; }
}
