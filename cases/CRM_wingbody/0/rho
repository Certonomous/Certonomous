FoamFile{version 2.0;format ascii;class volScalarField;location "0";object rho;}
// Registered freestream density, pre-registration §4: rho = Re*mu/(U*cref).
// Present so the forces functionObject can be exercised by postProcess before a solve;
// rhoSimpleFoam computes rho from the thermophysical model at run time.
dimensions [1 -1 -3 0 0 0 0];
internalField uniform 0.04503298815;
boundaryField
{
    "(wing|body)" { type zeroGradient; }
    symmetry      { type symmetry; }
    farfield      { type calculated; value uniform 0.04503298815; }
}
