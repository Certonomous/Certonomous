{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1.00000000 0.00000000 0);

boundaryField
{
    inflow
    {
        type            fixedValue;
        value           uniform (1.00000000 0.00000000 0);
    }
    outflow
    {
        type            inletOutlet;
        inletValue      uniform (1.00000000 0.00000000 0);
        value           uniform (1.00000000 0.00000000 0);
    }
    airfoil
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}
