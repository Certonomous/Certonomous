FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 4e-07;

boundaryField
{
    inflow
    {
        type            fixedValue;
        value           uniform 4e-07;
    }
    outflow
    {
        type            inletOutlet;
        inletValue      uniform 4e-07;
        value           uniform 4e-07;
    }
    airfoil
    {
        type            kLowReWallFunction;
        value           uniform 1e-12;
    }
    frontAndBack
    {
        type            empty;
    }
}
