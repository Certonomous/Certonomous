FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     simpleFoam;
startFrom       startTime;
startTime 0;
stopAt          endTime;
endTime         4000;
deltaT 1;
writeControl    timeStep;
writeInterval   4000;
purgeWrite 0;
writeFormat     ascii;
writePrecision  8;
timeFormat general;
runTimeModifiable no;

functions
{
    forceCoeffs1
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   1;
        patches         (body);
        rho             rhoInf;
        rhoInf          1.225;
        liftDir         (0 0 1);
        dragDir         (1 -0 -0);
        CofR            (0.522 0 0.144);
        pitchAxis       (0 1 0);
        magUInf         40;
        lRef            1.044;
        Aref            0.401696;
    }
}
