FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    body
    {
        type triSurfaceMesh;
        file "ahmed_25.stl";
    }
    nearBody
    {
        type searchableBox;
        min (-0.9396 -0.3501 -0.1152);
        max (3.0276 0.3501 0.4032);
    }
}

castellatedMeshControls
{
    maxLocalCells   4000000;
    maxGlobalCells  8000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.1;
    nCellsBetweenLevels 3;

    features
    (
        { file "ahmed_25.eMesh"; level 3; }
    );

    refinementSurfaces
    {
        body { level (3 4); }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        nearBody
        {
            mode inside;
            levels ((1e15 2));
        }
    }

    locationInMesh (6.786 0 0.144);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch    3;
    tolerance       2.0;
    nSolveIter      30;
    nRelaxIter      5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers {}
    expansionRatio 1.0;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    featureAngle 60;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    #include "meshQualityDict"
}

writeFlags ( scalarLevels layerSets layerFields );
mergeTolerance 1e-6;
