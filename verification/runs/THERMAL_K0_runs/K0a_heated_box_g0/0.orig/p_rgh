FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    hotSource
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    floorAdiabatic
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    ceilingCold
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    sideWalls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

