                Tiresrear { level (4 4); }
                WheelSupportfront1 { level (4 4); }
                WheelSupportfront2 { level (4 4); }
                WheelSupportrear { level (4 4); }
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        box1 { mode inside; levels ((1E15 1)); }
        box2 { mode inside; levels ((1E15 2)); }
        box3 { mode inside; levels ((1E15 3)); }
    }

    locationInMesh (-10.0 5.0 5.0);
    allowFreeStandingZoneFaces true;
}

