    features
    (
        { file "drivaer_466.eMesh"; level 4; }
    );

    refinementSurfaces
    {
        car
        {
            level (4 4);
            patchInfo { type wall; }
            regions
            {
                BodyA_Pillar { level (4 4); }
                BodyDoorhandles { level (5 5); }
