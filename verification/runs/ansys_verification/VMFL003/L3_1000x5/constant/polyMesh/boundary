FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          5;
        startFace       8995;
    }
    outlet
    {
        type            patch;
        nFaces          5;
        startFace       9000;
    }
    walls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          1000;
        startFace       9005;
    }
    wedge1
    {
        type            wedge;
        inGroups        1(wedge);
        nFaces          5000;
        startFace       10005;
    }
    wedge2
    {
        type            wedge;
        inGroups        1(wedge);
        nFaces          5000;
        startFace       15005;
    }
    defaultFaces
    {
        type            empty;
        inGroups        1(empty);
        nFaces          0;
        startFace       20005;
    }
)

