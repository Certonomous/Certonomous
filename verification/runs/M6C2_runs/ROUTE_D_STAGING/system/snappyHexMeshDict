FoamFile { version 2.0; format ascii; class dictionary; object snappyHexMeshDict; }
// M6 ROUTE (d) L1 -- MESH ADMISSION.
// addLayers FALSE: the admission question is whether snappy clears MESH_STANDARD
// 3.1/3.2 on this body at all. Layers are a separate question and adding them
// here would confound a layer failure with a snapping failure.
castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    m6_mp_L1.stl
    {
        type triSurfaceMesh;
        name m6;
        regions
        {
            wing_upper { name wing_upper; } wing_base { name wing_base; }
            wing_lower { name wing_lower; } wing_nose { name wing_nose; }
            cap_upper  { name cap_upper;  } cap_base  { name cap_base;  }
            cap_lower  { name cap_lower;  } cap_nose  { name cap_nose;  }
            crown      { name crown;      }
        }
    }
    nearWing
    {
        type searchableBox;
        min (-1.0 -0.1 -1.0);
        max ( 2.5  1.6  1.0);
    }
}

castellatedMeshControls
{
    maxLocalCells       4000000;
    maxGlobalCells      8000000;   // CAP: checked against the DELIVERED count after
                                   // the build -- snappy STOPS REFINING AND CONTINUES
                                   // when a cap binds, producing a quietly coarser mesh
    minRefinementCells  10;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces false;
    features ( { file "m6_mp_L1.eMesh"; level 4; } );
    refinementSurfaces
    {
        m6
        {
            level (3 4);
            patchInfo { type wall; }
            regions
            {
                wing_nose { level (4 5); patchInfo { type wall; } }  // LE curvature
                crown     { level (4 5); patchInfo { type wall; } }  // tip
                cap_nose  { level (4 5); patchInfo { type wall; } }
            }
        }
    }
    refinementRegions { nearWing { mode inside; levels ((1E15 2)); } }
    // In the fluid, far from the body, and deliberately NOT on any face or edge
    // of the background block -- an on-face point makes snappy pick the wrong side.
    locationInMesh (-5.013 5.017 5.019);
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          50;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true; layers {}; expansionRatio 1.2; finalLayerThickness 0.3;
    minThickness 0.1; nGrow 0; featureAngle 60; nRelaxIter 3;
    nSmoothSurfaceNormals 1; nSmoothNormals 3; nSmoothThickness 10;
    maxFaceThicknessRatio 0.5; maxThicknessToMedialRatio 0.3; minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0; nLayerIter 50;
}

meshQualityControls { #include "meshQualityDict" }

writeFlags ( );
mergeTolerance 1e-6;
