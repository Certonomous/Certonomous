FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}

// Robin condition -k dT/dn = h (T_face - T_inf) as a mixed patch:
//   valueFraction = 1/(1 + k/(h d)),  d = 6.2500000000e-05 m  (half the y spacing)
dimensions      [0 0 0 1 0 0 0];
internalField   uniform 350;
boundaryField
{
    base         { type fixedValue; value uniform 350; }
    tip          { type zeroGradient; }
    top          { type mixed; refValue uniform 300; refGradient uniform 0; valueFraction uniform 1.562475586319e-05; value uniform 300; }
    bottom       { type mixed; refValue uniform 300; refGradient uniform 0; valueFraction uniform 1.562475586319e-05; value uniform 300; }
    frontAndBack { type empty; }
}
