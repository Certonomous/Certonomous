FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
application     laplacianFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2;
deltaT          5e-05;
writeControl    runTime;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  14;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;
