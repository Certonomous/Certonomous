FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         900.0;

deltaT          0.5;

writeControl    runTime;
writeInterval   5.0;

purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   12;
runTimeModifiable no;
adjustTimeStep  no;

functions
{
    cellProbes
    {
        type            probes;
        libs            (sampling);
        region          module;
        writeControl    timeStep;
        writeInterval   1;
        fields          (T);
        probeLocations
        (
            (0.050000 0.015000 0.500000)
            (0.050000 0.114000 0.500000)
            (0.050000 0.246000 0.500000)
        );
    }
    moduleMinMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        region          module;
        writeControl    timeStep;
        writeInterval   1;
        fields          (T);
    }
}

// ****************************************************************** //
