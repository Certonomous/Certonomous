+                cx = (a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0])
+                if max(abs(c) for c in cx) > 1e-14:
+                    noncol = True
+    return n, ext, noncol
