FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}

dimensions      [0 0 0 1 0 0 0];
internalField   uniform 300;
boundaryField
{
    inlet     { type fixedValue; value uniform 300; }
    outlet    { type zeroGradient; }
    wallLo    { type fixedGradient; gradient uniform 500; }
    wallHi    { type fixedGradient; gradient uniform 500; }
    frontBack { type empty; }
}
