FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/housing/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

2
(
    walls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          125;
        startFace       300;
    }
    housing_to_core
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          25;
        startFace       425;
        sampleMode      nearestPatchFace;
        sampleRegion    core;
        samplePatch     core_to_housing;
    }
)

