FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/core/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

2
(
    walls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          125;
        startFace       300;
    }
    core_to_housing
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          25;
        startFace       425;
        sampleMode      nearestPatchFace;
        sampleRegion    housing;
        samplePatch     housing_to_core;
    }
)

