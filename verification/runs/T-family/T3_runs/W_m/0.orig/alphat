{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alphat;
}

dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;
boundaryField
{
    inlet        { type calculated; value uniform 0; }
    outlet       { type calculated; value uniform 0; }
    upstreamWall { type alphatJayatillekeWallFunction; Prt 0.85; value uniform 0; }
    stepWall     { type alphatJayatillekeWallFunction; Prt 0.85; value uniform 0; }
    heatedWall   { type alphatJayatillekeWallFunction; Prt 0.85; value uniform 0; }
    topWall      { type alphatJayatillekeWallFunction; Prt 0.85; value uniform 0; }
    frontAndBack { type empty; }
}
