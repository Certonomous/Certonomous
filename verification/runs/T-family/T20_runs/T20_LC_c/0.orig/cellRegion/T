FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/cellRegion";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;

boundaryField
{
    "channelFaceLo|channelFaceHi"
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        h               constant 25;
        Ta              constant 293;
        emissivity      0;
        kappaMethod     solidThermo;
        value           uniform 293;
    }
    "endLo|endHi"
    {
        type            zeroGradient;
    }
    "front|back"
    {
        type            empty;
    }
}

