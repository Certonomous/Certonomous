// Martin & Moyce (1952) square-column dam break, a = 2 1/4 in = 0.05715 m.
// Domain: 15a wide x 2a tall x (a/20) thin slab (2D case, empty front/back).
// Medium (gate) mesh: dx=dy=dz=a/20 -> 300 x 40 x 1 cells.
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

a       0.05715;

convertToMeters 1;

vertices
(
    (0          0          0)
    (#calc "15*$a"  0          0)
    (#calc "15*$a"  #calc "2*$a"  0)
    (0          #calc "2*$a"  0)
    (0          0          #calc "$a/20")
    (#calc "15*$a"  0          #calc "$a/20")
    (#calc "15*$a"  #calc "2*$a"  #calc "$a/20")
    (0          #calc "2*$a"  #calc "$a/20")
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (300 40 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    leftWall
    {
        type wall;
        faces ( (0 4 7 3) );
    }
    rightWall
    {
        type wall;
        faces ( (1 2 6 5) );
    }
    lowerWall
    {
        type wall;
        faces ( (0 1 5 4) );
    }
    atmosphere
    {
        type patch;
        faces ( (3 7 6 2) );
    }
    defaultFaces
    {
        type empty;
        faces ( (0 3 2 1) (4 5 6 7) );
    }
);

mergePatchPairs
(
);

