FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.water.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 1;
        // SINGLE-VARIABLE TEST (2026-07-30): cAlpha 1->0, disabling VOF
        // interface compression, everything else identical to the gate
        // case (damBreak_MM_a2p25in_medium_closedbox). Tests whether the
        // artificial interface-compression velocity (which acts along the
        // interface normal to counter numerical smearing) is contributing
        // to the front's systematic, time-growing overshoot -- the surge
        // toe is thin and near-tangential to the probe height, exactly the
        // geometry where a compression term's normal-direction correction
        // could have an unintended forward push.
        cAlpha          0;

        MULESCorr       yes;
        nLimiterIter    5;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    }

    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-07;
        relTol          0.05;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    1;
    nCorrectors         3;
    pRefCell            0;
    pRefValue           0;
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        ".*" 1;
    }
}


