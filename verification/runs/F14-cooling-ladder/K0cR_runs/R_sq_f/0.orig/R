FoamFile
{
    version     2.0;
    format      ascii;
    class       volSymmTensorField;
    location    "0.orig";
    object      R;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform (0.0024270163286666665 0 0 0.0024270163286666665 0 0.0024270163286666665);

boundaryField
{
    hotWall
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    coldWall
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    topWall
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    bottomWall
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    frontAndBack { type empty; }
}

