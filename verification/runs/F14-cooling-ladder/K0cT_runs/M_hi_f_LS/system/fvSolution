FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0.01;
    }

    "(U|T|k|omega|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0.01;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;

    residualControl
    {
        // residual stop REMOVED for the continuation stage; see
        // continue_past_residual.sh.  Convergence is judged by the
        // graded-quantity peak-to-peak criterion, never by these.
        p_rgh           1e-30;
        U               1e-30;
        T               1e-30;
        "(k|omega|epsilon)" 1e-30;
    }
}

relaxationFactors
{
    fields
    {
        p_rgh           0.7;
    }
    equations
    {
        U               0.4;
        T               0.6;
        "(k|omega|epsilon)" 0.4;
    }
}

