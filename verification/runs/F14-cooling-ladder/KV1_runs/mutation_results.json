  "M5_weight_dropped": {
    "why": "surfaceFieldValue silently returns the UNWEIGHTED sum(phi), which is what it really does when canWeight() is false. This one is aimed at the GUARD, not at the balance: the auditor must REFUSE, not report a wrong number.",
