FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300.0;

boundaryField
{
    hotWall         { type fixedValue; value uniform 330.000000000; }
    coldWall        { type fixedValue; value uniform 270.000000000; }
    adiabaticWalls  { type zeroGradient; }
    frontAndBack    { type empty; }
}

