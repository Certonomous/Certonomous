FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325.0;

boundaryField
{
    hotWall         { type calculated; value uniform 101325.0; }
    coldWall        { type calculated; value uniform 101325.0; }
    adiabaticWalls  { type calculated; value uniform 101325.0; }
    frontAndBack    { type empty; }
}

