FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     buoyantBoussinesqPimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         80.0;
deltaT          0.005;
writeControl    adjustableRunTime;
writeInterval   20.0;
purgeWrite      0;
writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable false;
adjustTimeStep  yes;
maxCo           2.0;
maxDeltaT       0.25;

functions
{
    T_rack_in_mdot
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            rack_in;
        operation       weightedAverage;
        fields          (T);
        weightField     phi;
        writeFields     false;
        writeToFile     true;
        log             true;
        executeControl  runTime;
        executeInterval 0.2;
        writeControl    runTime;
        writeInterval   0.2;
    }
    T_rack_out_area
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            rack_out;
        operation       areaAverage;
        fields          (T);
        writeFields     false;
        writeToFile     true;
        log             true;
        executeControl  runTime;
        executeInterval 0.2;
        writeControl    runTime;
        writeInterval   0.2;
    }
    phi_return
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            return;
        operation       sum;
        fields          (phi);
        writeFields     false;
        writeToFile     true;
        log             true;
        executeControl  runTime;
        executeInterval 0.2;
        writeControl    runTime;
        writeInterval   0.2;
    }
}

