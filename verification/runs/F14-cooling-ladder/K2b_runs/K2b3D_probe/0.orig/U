FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0.orig";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    floor
    {
        type            noSlip;
    }
    ceiling
    {
        type            noSlip;
    }
    wall_cold
    {
        type            noSlip;
    }
    wall_hot
    {
        type            noSlip;
    }
    wall_x0
    {
        type            noSlip;
    }
    wall_x1
    {
        type            noSlip;
    }
    rack_top
    {
        type            noSlip;
    }
    rack_end
    {
        type            noSlip;
    }
    tile
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 1.4;
        value           uniform (0 0 0);
    }
    return
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    rack0_in
    {
        type            flowRateOutletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
    rack1_in
    {
        type            flowRateOutletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
    rack2_in
    {
        type            flowRateOutletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
    rack3_in
    {
        type            flowRateOutletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
    rack0_out
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
    rack1_out
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
    rack2_out
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
    rack3_out
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant 0.35;
        value           uniform (0 0 0);
    }
}

