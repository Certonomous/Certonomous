FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 303.150000000;

boundaryField
{
    hotWall    { type fixedValue; value uniform 323.150000000; }
    coldWall   { type fixedValue; value uniform 283.150000000; }
    topWall    { type zeroGradient; }
    bottomWall { type zeroGradient; }
    frontAndBack { type empty; }
}

