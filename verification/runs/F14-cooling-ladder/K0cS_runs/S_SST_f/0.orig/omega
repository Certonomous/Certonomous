FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 2.098273269e+00;

boundaryField
{
    hotWall
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    coldWall
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    topWall
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    bottomWall
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    frontAndBack { type empty; }
}

