FoamFile
{
    version 2.0;
    format  ascii;
    class   dictionary;
    object  fvSolution;
}

solvers
{
    "(rho|rhoU|rhoE)"
    {
        solver          diagonal;
    }

    U
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-09;
        relTol          0.01;
    }

    e
    {
        $U;
        relTol          0.1;
    }

    "(k|omega)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         2;
        tolerance       1e-10;
        relTol          0.01;
    }
}

residualControl
{
    p       1e-4;
    U       1e-4;
    e       1e-4;
    "(k|omega)" 1e-4;
}
