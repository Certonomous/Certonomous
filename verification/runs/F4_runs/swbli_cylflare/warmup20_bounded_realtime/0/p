FoamFile
{
    version 2.0;
    format  ascii;
    class   volScalarField;
    object  p;
}
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 576.0;
boundaryField
{
    inlet      { type fixedValue; value uniform 576.0; }
    outlet     { type zeroGradient; }
    axis       { type empty; }
    wall       { type zeroGradient; }
    farfield   { type zeroGradient; }
    frontWedge { type wedge; }
    backWedge  { type wedge; }
}
