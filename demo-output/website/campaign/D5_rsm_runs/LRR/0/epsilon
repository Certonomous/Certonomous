FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.018;

boundaryField
{
    "(wallTop|wallSide)"
    {
        type            epsilonWallFunction;
        value           uniform 0.018;
    }
    inflow  { type cyclic; }
    outflow { type cyclic; }
    "(symmetryBottom|symmetrySide)" { type symmetry; }
}
