/*--------------------------------*- C++ -*----------------------------------*\
  F8 -- coarse FEASIBILITY refinement, deliberately far below the tutorial's
  levels (surface 7/7, TE feature 11). Reduced here to keep global cell count
  under this project's proven ~579k ceiling on a 16 vCPU / 32 GiB box. This
  mesh is NOT expected to resolve the boundary layer or tip vortex to
  engineering accuracy -- see F8 report for the resolution-vs-ceiling math.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version 2.0;
    format  ascii;
    class   dictionary;
    object  snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    blade.stl
    {
        type triSurfaceMesh;
        name blade;
    }
}

castellatedMeshControls
{
    features
    (
        { file "bladess.eMesh"; level 7; }
        { file "bladeps.eMesh"; level 7; }
        { file "bladete.eMesh"; level 8; }
    );

    refinementSurfaces
    {
        blade
        {
            level (6 6);
        }
    }

    refinementRegions
    {
    }

    locationInMesh ( -0.5 0.5 0.5 );
    maxLocalCells 2000000;
    maxGlobalCells 500000;
    minRefinementCells 0;
    nCellsBetweenLevels 3;
    resolveFeatureAngle 15;
    allowFreeStandingZoneFaces true;
    planarAngle 30;
    maxLoadUnbalance 0.10;
}

snapControls
{
    nSolveIter 30;
    nSmoothPatch 3;
    tolerance 2.0;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    layers
    {
        "blade.*"
        { nSurfaceLayers 5; }
    }

    relativeSizes true;
    expansionRatio 1.25;
    finalLayerThickness 0.15;
    minThickness 0.001;
    nGrow 0;
    featureAngle 180;
    slipFeatureAngle 80;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
    nRelaxedIter 20;
    writeVTK false;
    noErrors false;
    layerRecovery 1;
    growZoneLayers false;
    projectGrownUp 0.0;
}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 4;
    maxInternalSkewness 4;
    maxConcave 80;
    minFlatness 0.5;
    minVol 1.00E-13;
    minTetQuality 1e-30;
    minArea -1.0;
    minTwist 0.02;
    minDeterminant 0.01;
    minFaceWeight 0.02;
    minVolRatio 0.01;
    minTriangleTwist -1;
    nSmoothScale 4;
    errorReduction 0.75;
}

debug 0;
mergeTolerance 1E-6;
autoBlockMesh false;
