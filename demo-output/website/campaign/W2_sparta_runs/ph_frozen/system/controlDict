FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

// backstop cap 5000 (pre-registered); settle criterion is in the solver
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         5000;
deltaT          1;
writeControl    timeStep;
writeInterval   5000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  15;
writeCompression uncompressed;
timeFormat      general;
timePrecision   15;
runTimeModifiable no;
