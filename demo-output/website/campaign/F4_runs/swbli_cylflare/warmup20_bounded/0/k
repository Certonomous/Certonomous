FoamFile
{
    version 2.0;
    format  ascii;
    class   volScalarField;
    object  k;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 2.4346;
boundaryField
{
    inlet      { type fixedValue; value uniform 2.4346; }
    outlet     { type zeroGradient; }
    axis       { type empty; }
    wall       { type fixedValue; value uniform 1e-6; }
    farfield   { type zeroGradient; }
    frontWedge { type wedge; }
    backWedge  { type wedge; }
}
