FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    inlet
    {
        type            patch;
        nFaces          80;
        startFace       63520;
    }
    outlet
    {
        type            patch;
        nFaces          80;
        startFace       63600;
    }
    bottom
    {
        type            symmetryPlane;
        inGroups        1(symmetryPlane);
        nFaces          160;
        startFace       63680;
    }
    top
    {
        type            patch;
        nFaces          400;
        startFace       63840;
    }
    obstacle
    {
        type            wall;
        inGroups        1(wall);
        nFaces          240;
        startFace       64240;
    }
    defaultFaces
    {
        type            empty;
        inGroups        1(empty);
        nFaces          64000;
        startFace       64480;
    }
)

