FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=128";
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 4.5e-05;

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 4.5e-05;
        value           uniform 4.5e-05;
    }
    body
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 4.5e-05;
    }
    procBoundary0to2
    {
        type            processor;
        value           uniform 4.5e-05;
    }
    procBoundary0to3
    {
        type            processor;
        value           uniform 4.5e-05;
    }
}


