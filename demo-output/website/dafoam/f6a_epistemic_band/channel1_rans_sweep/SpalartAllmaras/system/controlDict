FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// DEVIATION (F6a, documented, same pattern as ladder B2 for the duct cases):
// original controlDict loaded "libfrozenIncompressibleTurbulenceModels.so",
// a custom library from the paper authors' thesis codebase, not distributed
// in the public closure-challenge-benchmark clone and not part of stock
// OpenFOAM. Removed here; RASModel kOmegaSST (see constant/turbulenceProperties)
// resolves to OpenFOAM v2606's stock implementation instead.
// libs ( "libfrozenIncompressibleTurbulenceModels.so" );

#include "../fieldDef"

startFrom       latestTime;

stopAt          endTime;

// D9: SA's own log (solve_registry/hump_SpalartAllmaras_20260729T023234Z.log,
// the case-dir log.simpleFoam is a stale fragment from an earlier aborted
// attempt) shows it had NOT met its own gate at t=2000: nuTilda final
// residual 1.263e-6, Ux 8.86e-7, Uz 1.51e-6, all above the 5e-7 bar -- same
// class of problem kOmega had, just never checked. nuTilda decay rate over
// the last 500 iterations (~1.7e-3/iter, accelerating, not plateaued)
// projects ~550-800 more iterations to the gate. Extended with margin.
// D9 update: at t=3200, U (nuTilda already under gate) is NOT cleanly
// converging -- Ux final residual decayed smoothly to ~5.4e-7 near t=2600,
// then a growing oscillation appeared (spikes to ~2e-6 becoming more
// frequent/sustained through t=3200, currently plateaued oscillating near
// 1.8e-6). Extending further to determine whether this is a transient or a
// genuine limit cycle before reporting either way -- not relaxing the gate.
endTime         4200;

deltaT          1;

writeControl    timeStep;

// D9: was $endTime (2000) -- see realizableKE's INIT_NOTE.txt for the
// alignment trap that setting produced there. Not currently at risk here
// since we resume from latestTime=2000 (a multiple of any reasonable
// period), but periodic writes are the safer default going forward.
writeInterval   200;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// DEVIATION: #includeFunc residuals/convergenceProbes/singleGraph_* dropped
// (same v2606 caseDicts-path finding as B2). wallShearStress + wallValues
// reinstated below as inline definitions (not #includeFunc, which failed
// when invoked standalone via postProcess -- the sampledSurfaces "wallValues"
// object needs wallShearStress already registered in the same run) so both
// execute in sequence at each writeTime, matching the case's own
// postProcess.sh intent (wallShearStress then wallValues sampling it).
functions
{
    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeFields     yes;
        executeControl  writeTime;
        writeControl    writeTime;
    }

    wallValues
    {
        type            surfaces;
        libs            ("libsampling.so");
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          $wallValuesFields;
        surfaces
        (
            wallValues
            {
                type        patch;
                patches     (bottom);
            }
        );
    }
}


