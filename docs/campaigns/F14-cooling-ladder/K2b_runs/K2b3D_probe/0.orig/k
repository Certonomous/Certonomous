FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.orig";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.417824e-02;

boundaryField
{
    floor
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    ceiling
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    wall_cold
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    wall_hot
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    wall_x0
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    wall_x1
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    rack_top
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    rack_end
    {
        type            kqRWallFunction;
        value           uniform 1.417824e-02;
    }
    tile
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.1;
        value           uniform 1.417824e-02;
    }
    return
    {
        type            inletOutlet;
        inletValue      uniform 1.417824e-02;
        value           uniform 1.417824e-02;
    }
    rack0_in
    {
        type            zeroGradient;
    }
    rack1_in
    {
        type            zeroGradient;
    }
    rack2_in
    {
        type            zeroGradient;
    }
    rack3_in
    {
        type            zeroGradient;
    }
    rack0_out
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.1;
        value           uniform 1.276042e-03;
    }
    rack1_out
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.1;
        value           uniform 1.276042e-03;
    }
    rack2_out
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.1;
        value           uniform 1.276042e-03;
    }
    rack3_out
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.1;
        value           uniform 1.276042e-03;
    }
