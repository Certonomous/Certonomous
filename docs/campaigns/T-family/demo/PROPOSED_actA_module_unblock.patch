+#: sixteen points and carries the margin, and the housing is what the hand
+#: correlations and the monitors read, so a screen with only one of them
+#: cannot be checked against the other sheets. A bundle that carries only one
+#: of the two keys gets NOT_RECORDED in the other column, never a number.
+_ACT_A_COLUMNS = (
+    ("Power, W", "power_W", ""),
+    ("Airspeed, m/s", "airspeed_ms", ""),
+    ("Peak core temperature, C", "peak_core_T_degC", _TEMP),
+    ("Peak housing temperature, C", "peak_housing_T_degC", _TEMP),
+    ("Rise above inlet, K", "rise_above_inlet_K", _TEMP),
+    ("Margin to the 200 C limit, K", "margin_to_limit_K", _TEMP),
+    ("Uncertainty", "numerical_uncertainty", ""),
+)
