+#: The format a displayed temperature falls back to when the bundle does not
+#: state how it wants its temperatures shown. FULL PRECISION on purpose:
+#: dropping digits is a decision the record must take deliberately, never a
+#: module default that quietly rounds somebody else's evidence away.
+_FULL_PRECISION = ".6f"
+#: Stands in a column description where the column holds a DISPLAYED
+#: temperature, so that ``_columns_table`` can put the bundle's own precision
+#: there instead of a second hardcoded number.
+_TEMP = "T"
+
+
+def _display_spec(b: dict, default: str = _FULL_PRECISION) -> str:
+    """The format spec for a displayed temperature, read from the bundle.
+
+    ``display_precision`` is the bundle's own statement about how it wants its
+    temperatures shown, so it is read here rather than hardcoded a second time
+    in this module: the number of digits then lives in ONE place, the record,
+    and the screen and the sheet cannot disagree about it.
+
+    Two spellings are accepted. ``temperature_format`` is a format spec and is
+    used as given. ``temperatures_in_figures`` is the prose form the Act A
+    bundle carries today -- "0.1 degC, until the grid triple lands" -- and the
+    step it quotes is read off the front of the string and turned into a
+    number of decimals.
+
+    THIS ROUNDS A DISPLAY AND NEVER A RECORD, and it is deliberately timid: if
+    nothing recognisable is there the full-precision default stands, because a
+    cell that silently lost its digits looks exactly like a cell that never
+    had them. The bundle's own ``not_applied_to`` names what must NOT be
+    rounded -- planted-control magnitudes and anchor residuals -- and those
+    tables do not call this function.
+    """
+    prec = b.get("display_precision")
+    if not isinstance(prec, dict):
+        return default
+    explicit = prec.get("temperature_format")
+    if isinstance(explicit, str) and explicit:
+        return explicit
+    stated = prec.get("temperatures_in_figures")
+    if not isinstance(stated, str):
+        return default
+    match = re.match(r"\s*(\d+(?:\.\d+)?)", stated)
+    if not match:
+        return default
+    step = match.group(1)
+    decimals = len(step.split(".")[1]) if "." in step else 0
+    return f".{decimals}f"
+
+
+def _columns_table(title: str, columns, rows: list, temp_spec: str) -> dict:
+    """A result table built from a COLUMN DESCRIPTION and the bundle's rows.
+
+    The description may come from the bundle (``result_table_columns``) or, if
+    the bundle does not describe its own table, from this module's default for
+    that act. Either way EVERY CELL GOES THROUGH ``_fmt``: a row that does not
+    carry a column's key says NOT_RECORDED in that cell. A column can neither
+    invent a value nor quietly disappear, which is what makes it safe for the
+    column list to be data rather than code.
+
+    An entry is ``(header, key, spec)`` or ``{"header":, "key":, "format":}``.
+    ``spec`` of ``_TEMP`` means "a displayed temperature": the bundle's own
+    display precision is used, so adding a temperature column never hardcodes
+    a precision beside it.
+    """
+    cols = []
+    for c in columns:
+        if isinstance(c, dict):
+            cols.append((str(c.get("header", "")), str(c.get("key", "")),
+                         str(c.get("format") or "")))
+            continue
+        parts = list(c) + ["", "", ""]
+        cols.append((str(parts[0]), str(parts[1]), str(parts[2] or "")))
+    return {
+        "title": title,
+        "headers": tuple(header for header, _k, _s in cols),
+        "rows": [[_fmt(r, key, temp_spec if spec == _TEMP else spec)
+                  for _h, key, spec in cols] for r in rows],
+    }
+
+
