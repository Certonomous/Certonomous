+            ] + undefined,
+            next_investigations=[f"{e['title']}: {e['scope']}" for e in agenda],
+            compute={"spent_core_minutes": 0.0,
+                     "note": "no solver ran on this request"},
+        ))
+
+    script.save(out / "transcript.txt")
+    roster.all_idle()
+    print("Artifacts in", out)
+    return 0
