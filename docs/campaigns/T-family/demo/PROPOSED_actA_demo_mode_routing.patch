+"""The thermal intent's dispatcher: Act A through DEMO MODE, Act C unchanged.
+
+WHY THIS MODULE EXISTS AT ALL. ``router.WORKFLOWS`` maps one intent to one
+module, and the thermal intent covers two acts: the motor in its duct, and the
+battery module. Act A is ready to run through DEMO MODE; Act C is not, and must
+keep exactly the path it has today. A one-line change of the intent's module
+would move both. This module moves one.
+
+WHAT ROUTING ACT A THROUGH HERE ACTUALLY BUYS, and it is the whole point:
+:func:`demo_sequencer.make_act_entry` DROPS ``params``. Its own docstring says
+so and says why, at ``demo_sequencer.py`` lines 697 to 703: "The served
+geometry comes from the ACT's own ``served_stl`` by way of ``_stage_geometry``,
+never from what an operator happened to upload, so the picture on screen and
+the grid behind the numbers are bound structurally instead of by convention."
+
+That is the fix. Today ``thermal_display`` announces
+``params.get("surface")``, which is whatever filename an operator uploaded, and
+the file it names has been the retired body. Under this dispatch the surface
+is the act's, the act measures it against the solved case before it renders,
+and an upload cannot reach the viewport for this act at all.
+
+WHAT THIS MODULE READS FROM ``params``, AND WHAT IT WILL NOT. It reads exactly
+one key, ``thermal_screens``, which the router sets to ``"A"`` or ``"C"`` from
+the body named in the request. It never reads ``surface`` and never forwards
+``params`` to the DEMO MODE entry, because forwarding it is precisely what
+would put an uploaded filename back in the path.
+"""
+
+from __future__ import annotations
+
+from .demo_sequencer import make_act_entry
+
+#: The transcript label for the motor act.
+LABEL = "motor in duct thermal map"
+
+#: Built once at import. Importing the act module is what registers the act,
+#: and ``make_act_entry`` does that import itself.
+_ACT_A = make_act_entry("motor-thermal",
+                        act_module="workflows.motor_thermal_act",
+                        label=LABEL)
+
+
+def main(request: str | None = None, params: dict | None = None,
+         emit=None) -> int:
+    """Dispatch on the act the router identified.
+
+    Act A walks the nine DEMO MODE stages. Everything else keeps the path it
+    has today, byte for byte, including Act C.
+    """
+    screens = str((params or {}).get("thermal_screens") or "").strip().upper()
+    if screens == "A":
+        # ``params`` is deliberately NOT forwarded. See the module docstring.
+        return _ACT_A(request=request, emit=emit)
+
+    from . import thermal_display
+
+    return thermal_display.main(request=request, params=params, emit=emit)
